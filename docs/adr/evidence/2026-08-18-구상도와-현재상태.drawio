        <mxCell id="b4" value="④ 사업계획서 자동 작성 · 화면 — 도면 8번 · SPEC S1~S7" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="2240" height="190" as="geometry" />
        </mxCell>
        <mxCell id="b4_1" value="도면 8번 ①~⑦ 전부 없다&#xa;&#xa;계획 파일도 아직 안 썼다 (틀린 문서를 미리 쓰지 않는다)&#xa;질문 타이밍만 정해져 있다 — 초안을 먼저 다 내고 못 채운 자리에서 묻는다 (ADR-0028)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="50" y="50" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4_2" value="재료 &lt;b&gt;둘이&lt;/b&gt; 이미 있다&#xa;&#xa;공고 상세에 &apos;내야 할 서류&apos;와 작성 항목 트리가 뜬다 (도면 8-② 입력 · plan/11)&#xa;위키 노드가 근거를 달고 선다 (도면 8-③ 입력 · plan/12)&#xa;&lt;b&gt;남은 것이 ⑤ 생성이고 거기가 LLM 이다&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="590" y="50" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4_3" value="화면 S1 · S4 · S5 · S7 은 돈다&#xa;&#xa;S1 파일 올리기 /wiki/files — 단계 다섯 · 7건 18.1초 · 자리 15/15 (plan/15)&#xa;S7 내 사업 위키 /wiki — 궤도 열다섯 · 값마다 근거 · 마크다운 (plan/14)&#xa;S4 · S5 제품 목록 · 공고 상세 + 운영 조회 화면 넷 (ADR-0027)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="1130" y="50" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4_4" value="화면 S2 · S3 · S6 은 없다&#xa;&#xa;일곱 중 셋이 없다. 있는 넷도 &lt;b&gt;대부분 &apos;아직 없어요&apos;로 비어 있고 그게 의도다&lt;/b&gt;&#xa;예시 데이터를 넣지 않는다&#xa;브라우저가 없어 호버 · 포커스 · 클릭 전환은 아직 눈으로 못 봤다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="1670" y="50" width="520" height="110" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="⑤ 어디서 도나 — 도면 9번 기술 스택 · 2026-08-18 바뀌었다" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="2240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b6_1" value="Vercel finnect-web — 화면만&#xa;&#xa;제품 화면과 운영 조회 화면 넷. HTTPS.&#xa;&lt;b&gt;브라우저는 API 주소를 모른다&lt;/b&gt; — 서버 컴포넌트가 부른다&#xa;plan/10 · ADR-0027" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b6">
          <mxGeometry x="50" y="50" width="690" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b6_2" value="이 서버 — API · 워커 · DB · 파일&#xa;&#xa;Caddy :443 (Let&apos;s Encrypt IP 인증서 · ADR-0036)&#xa;  → uvicorn 127.0.0.1:8101 → PostgreSQL :55433&#xa;  + data/user-files/ · data/attachments/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b6">
          <mxGeometry x="790" y="50" width="690" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b6_3" value="&lt;b&gt;API 가 Vercel 에서 내려왔다&lt;/b&gt; — ADR-0035 가 ADR-0026 을 대체&#xa;&#xa;이유는 자원이 아니라 성질이다. 함수 파일시스템이 읽기 전용이라&#xa;올리기(①)와 OCR 모델 내려받기가 거기서 안 된다&#xa;실측은 오히려 넉넉했다 — 메모리 1,820 / 3,009MB · 패키지 450MB / 5GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#16181b;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b6">
          <mxGeometry x="1530" y="50" width="690" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="LLM 을 아직 한 번도 안 불렀고 제공자도 안 정해졌다. &lt;b&gt;그런데 이것 하나가 더는 전부를 막지 않는다&lt;/b&gt; — plan/12 가 포트를 파고 스텁을 끼워 지나갔다(ADR-0031). 라우팅 · 근거 연결 · 병합 · 충돌이 전부 결정론이라 제공자 없이 돈다.&#xa;남은 것 넷.  ① &lt;b&gt;진짜 추출기&lt;/b&gt; — 스텁은 픽스처 7건 밖에서 안 돈다. 새 회사에서는 위키가 아예 안 선다  ·  ② plan/11 T-0036 양식 구간 판별 — 거기서 LLM 은 라벨러가 아니라 &lt;b&gt;판별기 자체&lt;/b&gt;라 이 방법이 안 통한다  ·  ③ 도면 6-C · 7-②③ 공고 Embedding 과 적합도  ·  ④ 도면 8번 집필" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f4;strokeColor=#d92d20;fontColor=#d92d20;fontSize=12;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1840" width="2240" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
