        <mxCell id="oc" value="우리가 하는 일&#xa;identity · 중심" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8e8fb;strokeColor=#5b5bd6;fontColor=#332f7a;fontStyle=1;fontSize=11;" vertex="1" parent="1">
