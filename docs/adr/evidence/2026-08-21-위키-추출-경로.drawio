<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="1. 흐름 — 파일에서 사실까지">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="위키 추출 경로 — 파일 하나가 사실이 되기까지" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t1b" value="2026-08-21 · c_dasiro(다시로) · c_narin(나린데이터) 실측 기준. 명령은 uv run python -m finnect.wiki --company &lt;id&gt; &lt;파일들&gt;" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="s0" value="사용자 파일" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a0" value="&lt;b&gt;data/user-files/&amp;lt;company_id&amp;gt;/&amp;lt;sha[:2]&amp;gt;/&amp;lt;sha&amp;gt;&lt;/b&gt;&#xa;키가 (company_id, sha256) 다. 회사 사이 중복 제거를 안 한다 — 같은 파일이 회사마다 한 벌씩 쌓이는 것이 의도다(ADR-0029).&#xa;확장자가 없는 콘텐츠 주소라 openpyxl 에 경로를 넘기면 안 된다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="95" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="① 해독&#xa;attach/extract.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="포맷을 &lt;b&gt;내용으로&lt;/b&gt; 판정한다(attach/formats.py). 확장자를 믿지 않는다.&#xa;hwpx · docx · pdf · xlsx · pptx + &lt;b&gt;OCR&lt;/b&gt;(rapidocr · Det=SERVER).&#xa;OCR 을 끄면 스캔 PDF 는 empty, 그림은 unsupported 로 &lt;b&gt;기록된다&lt;/b&gt; — 조용히 안 버린다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="195" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="② 청킹&#xa;wiki/chunk.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="해독 텍스트를 조각으로 쪼개고 &lt;b&gt;위치정보를 심는다&lt;/b&gt; — page · heading · char_start · char_end.&#xa;&lt;b&gt;여기서만 심을 수 있다.&lt;/b&gt; 나중에 붙이는 것은 불가능하다(ADR-0014).&#xa;실측 — 다시로 36청크 · 나린데이터 24청크(그중 쪽 번호 있는 것 14)." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="295" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="③ LLM 추출&#xa;wiki/extract.py&#xa;LlmExtractor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;파일당 호출 1회.&lt;/b&gt; 파일 전체 텍스트를 주고 사실 목록을 받는다. 일곱 건에 $0.03.&#xa;WIKI_EXTRACTOR=llm 일 때만 돈다. &lt;b&gt;기본값은 stub&lt;/b&gt; 이고 스텁은 다시로 픽스처 7건 밖에서 UnknownFile 이다.&#xa;호출이 전부 Langfuse 로 남는다(ADR-0038)." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="395" width="500" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="④ 라우팅&#xa;wiki/topics.py&#xa;(2쪽 참조)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;여기가 사람이 만든 표다.&lt;/b&gt; LLM 이 준 라벨을 슬롯이나 노드로 보낸다.&#xa;표 둘 — &lt;b&gt;SLOT_ALIASES&lt;/b&gt;(원문표현 → 슬롯, 43줄) · &lt;b&gt;TOPIC_NODE&lt;/b&gt;(topic → 노드, 23줄).&#xa;&lt;b&gt;결정론이다.&lt;/b&gt; LLM 이 목적지를 정하면 같은 사실이 어제는 A 오늘은 B 로 간다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="515" width="500" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="⑤ 병합&#xa;wiki/merge.py&#xa;(3쪽 참조)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a5" value="dedupe_key() 로 같은 주장을 묶고 decide() 로 상태를 매긴다.&#xa;상태 셋 — &lt;b&gt;current · superseded · conflict&lt;/b&gt;.&#xa;&lt;b&gt;SlotSpec.dated 한 칸이 시계열과 충돌을 가른다.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="635" width="500" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s6" value="⑥ 저장" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="760" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;wiki_fact&lt;/b&gt; 사실 하나 = 주장. 충돌하면 둘 다 남는다.&#xa;&lt;b&gt;wiki_evidence&lt;/b&gt; 그 사실이 어느 청크에서 나왔나. &lt;b&gt;근거 없는 wiki_fact 행은 만들지 않는다.&lt;/b&gt;&#xa;마크다운은 저장하지 않는다 — 읽을 때마다 만드는 뷰다(wiki/markdown.py)." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="755" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="c1" value="&lt;b&gt;LLM 이 정하는 것 / 안 정하는 것&lt;/b&gt;&#xa;&#xa;&lt;b&gt;정한다&lt;/b&gt;  topic 라벨 · slot_key(문서가 쓴 말) · value(정규화한 값) · text(원문 문장) · as_of · qualifier · &lt;b&gt;anchor&lt;/b&gt;(원문에 있는 조각)&#xa;&#xa;&lt;b&gt;안 정한다&lt;/b&gt;  &lt;b&gt;목적지&lt;/b&gt;. 어느 슬롯인지 어느 노드인지는 ④가 표로 정한다&#xa;&#xa;&lt;b&gt;못 한다&lt;/b&gt;  검색·도구 사용. 열면 어느 청크가 어느 문장에 들어갔는지 사후 복원이 안 된다&#xa;&#xa;anchor 가 원문에 없으면 그 사실은 &lt;b&gt;근거가 없어서 버려진다.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=#f3effa;strokeColor=#9673a6;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="395" width="260" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="a3" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lg" value="실측 — 두 페르소나 비교" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;verticalAlign=top;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="640" width="260" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="lgt" value="                       다시로    나린데이터&#xa;업력                   2.4년      3개월차&#xa;청크                    36         24&#xa;사실                   187        104&#xa;  정형 슬롯             39         13&#xa;  서술 노드            143          7&#xa;충돌                     4         10&#xa;검토 대기(uncat)         6         12&#xa;&#xa;&lt;b&gt;서술 노드가 20분의 1이다.&lt;/b&gt;&#xa;3개월차 회사에 재료가 없다." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontFamily=monospace;spacing=4;" vertex="1" parent="lg">
          <mxGeometry x="8" y="22" width="248" height="155" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. 라우팅 — 표 둘이 목적지를 정한다">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h" value="라우팅 — SLOT_ALIASES 와 TOPIC_NODE" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="hb" value="둘 다 src/finnect/wiki/topics.py 에 있는 &lt;b&gt;사람이 만든 dict&lt;/b&gt; 다. LLM 은 이 표를 못 바꾼다." style="text;html=1;fontSize=11;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="in" value="&lt;b&gt;LLM 이 준 사실 하나&lt;/b&gt;&#xa;&#xa;topic      = &quot;company_profile&quot;&#xa;slot_key   = &quot;상시근로자&quot;&#xa;value      = &quot;2&quot;&#xa;text       = &quot;상시근로자 2명&quot;&#xa;as_of      = null&#xa;anchor     = &quot;상시근로자&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="330" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="q" value="slot_key 가 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="270" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="in" target="q"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="lb1" value="&lt;b&gt;SLOT_ALIASES&lt;/b&gt;&#xa;topics.py:101 · &lt;b&gt;43줄&lt;/b&gt;&#xa;&#xa;원문 표현 → 슬롯 이름&#xa;&lt;b&gt;왼쪽은 문서가 쓴 말, 오른쪽은 우리 이름이다.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lb1x" value="상시 근로자  ┐&#xa;종업원 수    │&#xa;구성원       ├→  headcount&#xa;임직원       │&#xa;직원 수      ┘&#xa;&#xa;소재지 · 사업장소재지 · 본사&#xa;본점소재지 · 주소   →  location&#xa;&#xa;개업연월일 · 개업일&#xa;설립일 · 설립연월일 →  founded_on" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=10;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="510" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="lb1y" value="&lt;b&gt;표현이 넷 다 달라도 한 슬롯으로 모인다.&lt;/b&gt;&#xa;문자열이 다르다고 슬롯이 갈리면 안 된다.&#xa;다시로 코퍼스에 직원 수가 이 넷으로 있고 시점이 달라서 &lt;b&gt;시계열&lt;/b&gt; 이 된다.&#xa;&#xa;표에 없는 이름은 &lt;b&gt;버리지 않고&lt;/b&gt; uncategorized 로 세운다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="330" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="lb2" value="&lt;b&gt;TOPIC_NODE&lt;/b&gt;&#xa;topics.py:189 · &lt;b&gt;23줄&lt;/b&gt;&#xa;&#xa;topic → 서술 노드 이름&#xa;&lt;b&gt;LLM 은 TOPICS 밖의 라벨을 못 쓴다&lt;/b&gt;(자유 생성 금지)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="lb2x" value="customer_problem   ┐&#xa;customer_evidence  ┘→ problem&#xa;&#xa;service_overview   ┐&#xa;service_feature    │&#xa;service_differentiator │&#xa;development_status  ├→ solution&#xa;technology         │&#xa;patent             │&#xa;certification      ┘&#xa;&#xa;revenue · revenue_model&#xa;pricing · go_to_market → traction&#xa;cost · funding        → finance&#xa;&lt;b&gt;vision                → identity&lt;/b&gt;&#xa;team → team · roadmap → roadmap&#xa;region_link → region&#xa;target_customer → customer&#xa;market_size · market_trend&#xa;competitor            → market" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="510" width="330" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="out1" value="&lt;b&gt;정형 슬롯 14개&lt;/b&gt;&#xa;place_kind = 'slot'&#xa;&#xa;병합 키 = (이름, 한정어, 시점)&#xa;&lt;b&gt;같은 키에 값 둘이면 충돌&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="out2" value="&lt;b&gt;서술 노드 10개&lt;/b&gt;&#xa;place_kind = 'node'&#xa;&#xa;&lt;b&gt;병합 키가 없다.&lt;/b&gt; fact_key 로만 묶고&#xa;근거 청크를 쌓는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;spacing=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="780" y="810" width="330" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="out3" value="&lt;b&gt;uncategorized&lt;/b&gt;&#xa;표에 없는 이름·topic&#xa;&lt;b&gt;버리지 않는다&lt;/b&gt;&#xa;화면에 &quot;검토 대기&quot; 로 뜬다&#xa;&#xa;나린 12건 · 다시로 6건" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="465" y="790" width="240" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="ey" value="있다 → slot_of()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="q" target="lb1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="en" value="없다 → node_of()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="q" target="lb2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lb1y" target="out1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lb2x" target="out2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo3" value="못 찾으면" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.3;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="lb1y" target="out3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eo4" value="못 찾으면" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#b85450;exitX=0;exitY=0.9;entryX=1;entryY=0.3;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="lb2x" target="out3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="warn" value="&lt;b&gt;위 예시가 실제로 어디로 갔나 — uncategorized 다.&lt;/b&gt;&#xa;&#xa;표에는 &quot;상시 근로자&quot;(공백 있음)로 있고 LLM 이 준 것은 &quot;상시근로자&quot;(공백 없음)다.&#xa;slot_of() 는 &lt;b&gt;연속 공백만 한 칸으로 줄이고 지우지는 않는다&lt;/b&gt; — 정확 일치 조회라 빗나간다.&#xa;&#xa;반대 방향도 있다. 표의 &quot;본점소재지&quot;(공백 없음) 대 LLM 의 &quot;본점 소재지&quot;(공백 있음).&#xa;&lt;b&gt;표 자체가 표기가 섞여 있어서 어느 쪽으로 와도 절반이 빗나간다.&lt;/b&gt;&#xa;&#xa;merge.py 의 _norm() 은 &lt;b&gt;공백을 전부 지운다&lt;/b&gt; — 값 비교는 맞고 이름 조회만 안 맞는다. 4쪽 ①." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe4e4;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="330" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;topic 목록(TOPICS)은 25개다&lt;/b&gt; — TOPIC_NODE 의 23 + company_profile + application_history.&#xa;&#xa;뒤의 둘은 &lt;b&gt;일부러 노드가 없다.&lt;/b&gt; company_profile 은 SLOT_ALIASES 로 슬롯 여럿으로 갈려야 하고, application_history 는 gov_program 슬롯으로 간다.&#xa;&#xa;그래서 &lt;b&gt;company_profile 로 라벨된 서술 문장&lt;/b&gt; 은 갈 곳이 없다 — 나린 uncategorized 1건이 그것이다(&quot;설립 첫 사업연도이므로 결산 재무제표가 아직 없습니다&quot;)." style="text;html=1;align=left;verticalAlign=top;fillColor=#eef7ec;strokeColor=#82b366;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="90" width="330" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. 병합 — dated 한 칸이 가른다">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h" value="병합 — 시계열인가 충돌인가" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="hb" value="src/finnect/wiki/merge.py — dedupe_key() 로 묶고 decide() 로 상태를 매긴다" style="text;html=1;fontSize=11;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="spec" value="&lt;b&gt;SlotSpec — 슬롯 하나의 성질&lt;/b&gt;   topics.py:47&#xa;&#xa;label       화면에 쓰는 이름&#xa;&lt;b&gt;dated&lt;/b&gt;       시점을 갖는가  ←  &lt;b&gt;이 한 칸이 전부다&lt;/b&gt;&#xa;qualified   한정어를 갖는가 (조달 — 시드 / 정책자금)&#xa;eligibility 자격 판별의 입력인가 (여덟 슬롯)&#xa;unit        money / count / text — 화면 표기용" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="480" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="key" value="&lt;b&gt;dedupe_key()&lt;/b&gt;  merge.py:99&#xa;&#xa;슬롯   slot|이름|한정어|&lt;b&gt;시점&lt;/b&gt;|_norm(값)&#xa;노드   node|이름|fact_key or _norm(문장)&#xa;미분류 uncategorized|topic|_norm(문장)&#xa;&#xa;&lt;b&gt;_norm() 은 공백을 전부 지운다.&lt;/b&gt; OCR 이 낸&#xa;&quot;소프트웨어개발및공급업&quot; 과 문서의&#xa;&quot;소프트웨어 개발 및 공급업&quot; 이 하나로 모인다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="530" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="&lt;b&gt;dated = True 이고 시점이 다르다  →  시계열&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="1050" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="r1x" value="다시로 headcount — 표현 넷이 다르고 시점 넷이 다르다.  &lt;b&gt;성장이지 모순이 아니다.&lt;/b&gt;&#xa;&#xa;  상시 근로자  7   2025-08-22   superseded&#xa;  종업원 수    8   2025-11-30   superseded&#xa;  구성원      10   2026-01-31   superseded&#xa;  임직원      15   2026-08-31   &lt;b&gt;current&lt;/b&gt;&#xa;&#xa;&lt;b&gt;함정&lt;/b&gt; — current 는 &quot;가장 늦은 시점&quot; 이라 &lt;b&gt;미래 날짜도 current 다&lt;/b&gt;(2026-08-31 은 오늘 이후).&#xa;자격 판정은 &lt;b&gt;신청일 이전의 최신값&lt;/b&gt; 을 골라야 한다 — match/profile.py _pick()." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="294" width="1050" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="r2" value="&lt;b&gt;같은 키에 값이 둘 이상  →  전부 conflict&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="1050" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="r2x" value="다시로 funding — 같은 시점의 자본잉여금이 0 과 3억이다.  나린 founded_on — 값 셋.&#xa;&#xa;  자본잉여금        0        2024-12-31   conflict&#xa;  자본잉여금  300000000      2025-12-31   conflict&#xa;&#xa;  설립일     2026-05-26                   conflict     ← 법인 설립등기&#xa;  설립일     2026-06                      conflict     ← 월까지만&#xa;  개업연월일  2026-06-01                   conflict     ← 사업자등록&#xa;&#xa;&lt;b&gt;다수결로 풀지 않는다.&lt;/b&gt; 2 대 1 이라도 근거 수로 값을 정하지 않고 둘 다 보관하고 묻는다(F1-1-7).&#xa;&lt;b&gt;conflict 면 그 축을 판정하지 않는다.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="504" width="1050" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="r3" value="&lt;b&gt;dated = False  →  시점을 떼어 버린다&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="510" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="r3x" value="사업자등록번호는 문서마다 발급일이 달라도&#xa;&lt;b&gt;같은 값이다.&lt;/b&gt; 시점을 키에 넣으면 문서 수만큼&#xa;행이 생긴다.&#xa;&#xa;  business_no  105-88-21734  current  근거 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="724" width="510" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="r4" value="&lt;b&gt;dated = True 인데 시점이 없다  →  가장 오래된 것&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="690" width="510" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="r4x" value="시점 있는 값이 하나라도 있으면 그것이 &lt;b&gt;이긴다.&lt;/b&gt;&#xa;&quot;언제인지 모르는 값&quot; 이 최신값을 덮으면 안 된다.&#xa;&#xa;  나린 capital  50000000  (시점 없음)  superseded&#xa;  나린 capital  50000000  2026-08-10   &lt;b&gt;current&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=11;fontFamily=monospace;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="724" width="510" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4. 구멍 일곱 — 어디를 고치면 되나">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1169" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="h" value="구멍 일곱 — 2026-08-21 나린데이터 실측으로 잡은 것" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="hb" value="&lt;b&gt;일곱 다 다시로 코퍼스로는 하나도 안 걸렸다.&lt;/b&gt; 둘째 페르소나 한 벌을 태우고 나서 나왔다." style="text;html=1;fontSize=11;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="900" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="g1" value="wiki/topics.py — 사람이 만든 표" style="swimlane;startSize=32;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1050" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;① slot_of() 가 공백을 지우지 않는다&lt;/b&gt;      싸다 · 한 줄&#xa;&#xa;표에 &quot;상시 근로자&quot;(공백 O), LLM 이 준 것은 &quot;상시근로자&quot;(공백 X) → 빗나감.&#xa;표에 &quot;본점소재지&quot;(공백 X), LLM 이 준 것은 &quot;본점 소재지&quot;(공백 O) → 빗나감.&#xa;&lt;b&gt;표 자체가 표기가 섞여 있다.&lt;/b&gt; merge.py _norm() 은 이미 공백을 전부 지운다 — 같은 정규화를 쓰면 된다.&#xa;정확 일치 dict 조회라 부분 문자열 위험이 없다(match/sectors.py 와 다른 자리)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g1">
          <mxGeometry x="15" y="42" width="1020" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;② SLOT_ALIASES 에 자금 어휘가 없다&lt;/b&gt;      싸다 · 줄 추가&#xa;&#xa;차입금 · 투자 유치(금) · 잔여 현금 · 설립 후 누적 매출 · 설립 후 누적 지출 · 가입자 수 · 법인 설립등기일&#xa;→ 나린 uncategorized 11건의 대부분. &lt;b&gt;3개월차 회사의 자금 상태가 통째로 미분류다.&lt;/b&gt;&#xa;표가 43줄뿐이고 &lt;b&gt;다시로 문서에 나온 말로만&lt;/b&gt; 만들어져 있다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g1">
          <mxGeometry x="15" y="157" width="1020" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;③ identity 노드로 가는 topic 이 vision 하나뿐이다&lt;/b&gt;      중간&#xa;&#xa;&lt;b&gt;두 페르소나 다 identity 가 0건이다.&lt;/b&gt; ADR-0033 이 &quot;그래프의 중심&quot; 이라고 한 노드다.&#xa;다시로의 &quot;주식회사 다시로는 재고관리 자동화 소프트웨어를 주력으로&quot; 는 uncategorized 로 떨어졌다.&#xa;company_profile 로 라벨된 &lt;b&gt;서술 문장&lt;/b&gt; 이 갈 곳이 없는 것과 같은 뿌리다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g1">
          <mxGeometry x="15" y="247" width="1020" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="g2" value="wiki/topics.py + merge.py — 병합" style="swimlane;startSize=32;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1050" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;④ founded_on 이 설립등기일과 개업일을 합친다&lt;/b&gt;      ADR 필요&#xa;&#xa;SLOT_ALIASES 가 개업연월일 · 개업일 · 설립일 · 설립연월일 을 &lt;b&gt;한 슬롯&lt;/b&gt; 으로 보낸다.&#xa;나린은 법인이라 &lt;b&gt;둘이 실제로 다르다&lt;/b&gt; — 설립등기 2026-05-26, 사업자등록 2026-06-01. 값 셋이 conflict.&#xa;&lt;b&gt;공고가 &quot;설립일로부터 3년&quot; 인지 &quot;사업자등록일로부터&quot; 인지 정한다.&lt;/b&gt; 합치면 못 가른다 → 슬롯을 쪼갠다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g2">
          <mxGeometry x="15" y="42" width="1020" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;⑤ dedupe_key 가 법인 접두사를 안 벗긴다&lt;/b&gt;      싸다&#xa;&#xa;&quot;주식회사 나린데이터&quot;(근거 6) 대 &quot;나린데이터&quot;(근거 1) → company_name conflict.&#xa;_norm() 이 공백을 지워도 접두사는 남는다. &lt;b&gt;모든 법인이 이걸 맞는다.&lt;/b&gt;&#xa;주식회사 · (주) · ㈜ · 유한회사 를 비교용으로만 벗긴다 — &lt;b&gt;저장값은 그대로 둔다&lt;/b&gt;(topics.display() 와 같은 자리)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g2">
          <mxGeometry x="15" y="137" width="1020" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;⑥ location 이 &quot;위와 같음&quot; 을 값으로 받는다&lt;/b&gt;      작다 · 빈도 미측정&#xa;등록증의 &quot;본점 소재지 : 위와 같음&quot; 이 주소로 앉았다. &lt;b&gt;상호 참조인데 값이 됐다.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g2">
          <mxGeometry x="15" y="227" width="1020" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="g3" value="match/ — 자격과 인용" style="swimlane;startSize=32;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="1050" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="&lt;b&gt;⑦ rank.quotable() 이 콤마로 이어진 표 행을 통과시킨다&lt;/b&gt;      plan/12 T-0078&#xa;&#xa;나린 추천 3건이 전부 이 문장이다 — &quot;사업화 분야예요. &lt;b&gt;정산 연동 개발 18,000,000원, 외주 일부 포함&lt;/b&gt;&quot;&#xa;사업계획서 §6 소요자금 &lt;b&gt;표의 한 행&lt;/b&gt; 이 노드가 되고 그게 추천 이유로 화면까지 나갔다.&#xa;필터가 &lt;b&gt;탭·줄바꿈만&lt;/b&gt; 본다. 콤마로 이어진 표 행은 그냥 나간다.&#xa;근거 노드 둘이 &lt;b&gt;모두 finance&lt;/b&gt; 라 이유와 근거가 안 맞는다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g3">
          <mxGeometry x="15" y="42" width="1020" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="&lt;b&gt;(덧) 자격 규칙이 &quot;중소기업&quot; 을 못 읽는다&lt;/b&gt;      plan/17 · 43건&#xa;규칙이 못 읽은 조건 383건(328종) 중 1위가 중소기업 37 · 중소기업 또는 중견기업 3 · 중소·중견기업 3." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="g3">
          <mxGeometry x="15" y="142" width="1020" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
