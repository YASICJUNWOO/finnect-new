        <mxCell id="lg2" value="부분 — 절반만 돈다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg3" value="없다 — 코드가 한 줄도 없다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="900" width="240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg4" value="안 만들기로 정했다 — ADR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#949aa2;fontColor=#5f656d;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="900" width="240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lg5" value="끊긴 자리 · 블로커" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f4;strokeColor=#d92d20;fontColor=#d92d20;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="900" width="240" height="36" as="geometry" />
        </mxCell>
        <mxCell id="lgnote" value="수치는 전부 실측이다. 근거는 docs/adr/evidence/ 와 각 plan 파일에 있다. 자동 판정 수치는 눈으로 본 건수를 함께 적었다." style="text;html=1;align=left;verticalAlign=middle;fontColor=#5f656d;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1350" y="900" width="930" height="36" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="① 사업 위키 — 도면 1번 · plan/12 (진행중)" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="2240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="b1_1" value="① 파일 업로드 · 격리&#xa;&#xa;data/user-files/&lt;company_id&gt;/…&#xa;회사 사이 중복 제거 안 한다&#xa;ADR-0029 · T-0041" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="50" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_2" value="② 파싱 · 7포맷 + OCR&#xa;&#xa;HWP · HWPX · DOCX · PDF&#xa;XLSX · PPTX · 이미지&#xa;RapidOCR 로컬 · 검출 server&#xa;ADR-0030 · T-0042" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="320" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_3" value="③ Chunking&#xa;&#xa;픽스처 7건 전부 · 청크 36개&#xa;text == full[start:end] 로 검증&#xa;쪽 번호는 PDF 만&#xa;T-0043 · T-0047" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="590" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_4" value="여기서 끊긴다&#xa;&#xa;LLM 을 아직 한 번도 안 불렀다&#xa;담을 것(노드 스키마)도 미확정&#xa;T-0044 미착수 · T-0045 보류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f4;strokeColor=#d92d20;fontColor=#d92d20;fontSize=10;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="860" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_5" value="④ LLM Fact Extraction&#xa;&#xa;없다&#xa;&#xa;도면 3번 박스 전체가 여기다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="1130" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_6" value="⑤ 결정론적 라우팅&#xa;&#xa;없다&#xa;&#xa;도면 4번(온톨로지) 박스&#xa;topic 26개는 추출 라벨로만 쓴다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="1400" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_7" value="⑦ 노드 · 병합 / 충돌&#xa;&#xa;없다&#xa;&#xa;도면 5번 박스 · T-0046&#xa;도면의 confidence 는 안 쓴다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
          <mxGeometry x="1670" y="50" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b1_8" value="⑥ Markdown · ⑧⑨ Vector DB&#xa;&#xa;안 만들기로 정했다&#xa;&#xa;Markdown 은 저장소가 아니라 뷰&#xa;벡터는 회사당 노드 15개에 안 붙인다&#xa;ADR-0021 · plan/12 구상도와의 차이" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#949aa2;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b1">
