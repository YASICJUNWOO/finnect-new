        <mxCell id="p3t" value="데이터 계층과 화면 · 무엇을 생성하지 않는가" style="text;html=1;fontFamily=Pretendard;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="28" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="p3s" value="출처 service_spec.md §2.4 + function.md F7-3 — &lt;b&gt;환각 방지의 핵심은 계층별 생성 금지 규칙&lt;/b&gt;" style="text;html=1;fontFamily=Pretendard;fontSize=14;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="1000" height="24" as="geometry"/></mxCell>

        <mxCell id="h1" value="데이터 계층" style="text;html=1;fontFamily=Pretendard;fontSize=13;fontStyle=1;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="120" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="h2" value="화면" style="text;html=1;fontFamily=Pretendard;fontSize=13;fontStyle=1;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="h3" value="이 화면이 생성하지 않는 것" style="text;html=1;fontFamily=Pretendard;fontSize=13;fontStyle=1;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="400" height="24" as="geometry"/></mxCell>

        <mxCell id="L0" value="&lt;b&gt;사용자 입력&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;프로필 · 집필용 답변&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="100" y="160" width="320" height="76" as="geometry"/></mxCell>
        <mxCell id="L1" value="&lt;b&gt;L1 · 추출&lt;/b&gt;&amp;nbsp;&amp;nbsp;공고 구조화&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;LLM이 공고문 자유 텍스트에서 요건 · 금액 · 마감일 · 배점 · 서류를 스키마로 추출&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="100" y="280" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="L2" value="&lt;b&gt;L2 · 판별&lt;/b&gt;&amp;nbsp;&amp;nbsp;룰 엔진&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color:#0969da&quot;&gt;결정론. LLM을 거치지 않는다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;프로필 × L1 요건 대조 → 신청 가능 여부. 파생값(업력·만나이)은 공고 기준일로 매번 재계산&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="100" y="440" width="320" height="150" as="geometry"/></mxCell>
        <mxCell id="L3" value="&lt;b&gt;L3 · 집필&lt;/b&gt;&amp;nbsp;&amp;nbsp;LLM 생성&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;심사 항목 단위 초안 생성. 서술만 만들고 &lt;b&gt;수치와 판정은 L1·L2 출력만 인용&lt;/b&gt;한다&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="100" y="630" width="320" height="120" as="geometry"/></mxCell>

