<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="1. 네 층 — 세는 단위가 다르다">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1t" value="네 층 — topic 25 · slot 14 · node 10 · orbit 15" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p1s" value="2026-08-21 · 개수는 uv run python 으로 세어 맞췄다. 코드 자리는 src/finnect/wiki/{extract,merge,build,topics}.py 와 web/components/Orbit.tsx 다." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="f0" value="LLM 이 낸 사실 하나&#xa;wiki/extract.py Fact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f0a" value="&lt;b&gt;topic&lt;/b&gt; · &lt;b&gt;kind&lt;/b&gt;('slot' 또는 'node') · text · &lt;b&gt;anchor&lt;/b&gt; · fact_key · key · value · as_of · qualifier&#xa;&lt;b&gt;confidence 가 없다.&lt;/b&gt; 0.9 와 0.7 을 가를 눈금이 없어서 뺐다 — 대신 근거 청크 유무 · source_type · 충돌 여부 셋으로 말한다.&#xa;&lt;b&gt;anchor 가 원문에 없으면 그 사실은 버려진다.&lt;/b&gt; 근거 없는 wiki_fact 행을 만들지 않기 때문이다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="105" width="1060" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="f1" value="① topic — 25개&#xa;LLM 이 정하는 유일한 분류" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f1a" value="&lt;b&gt;TOPICS = frozenset(TOPIC_NODE) | {company_profile, application_history}&lt;/b&gt; — topics.py:222&#xa;&lt;b&gt;자유 생성 금지.&lt;/b&gt; 이 스물다섯 밖의 라벨은 uncategorized 로 선다. 프롬프트가 목록을 그대로 준다.&#xa;&lt;b&gt;여기까지가 LLM 의 몫이다.&lt;/b&gt; 목적지는 안 정한다 — 정하게 하면 같은 사실이 어제는 A 오늘은 B 로 간다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="215" width="1060" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="f2" value="② 라우팅 — merge.place()&#xa;사람이 만든 dict 둘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f2a" value="&lt;b&gt;SLOT_ALIASES&lt;/b&gt; 43줄(원문 표현 → 슬롯) · &lt;b&gt;TOPIC_NODE&lt;/b&gt; 23줄(topic → 노드). 둘 다 topics.py 안의 코드다.&#xa;&lt;b&gt;결정론이다.&lt;/b&gt; 같은 파일을 두 번 넣으면 같은 자리에 앉는다 — 2쪽에 판정 순서가 있다.&#xa;LLM 은 이 표를 못 바꾼다. 표에 없는 이름은 &lt;b&gt;버리지 않고&lt;/b&gt; 이유를 달아 uncategorized 로 세운다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="380" y="325" width="1060" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="f3a" value="slot — 14개&#xa;값의 자리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f3b" value="node — 10개&#xa;문장의 자리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="440" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f3c" value="uncategorized&#xa;검토 대기" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="440" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="f3d" value="&lt;b&gt;셋의 병합 키가 다르다. 그게 층을 가른 이유다.&lt;/b&gt;&#xa;&lt;b&gt;slot&lt;/b&gt;  키 = (이름, 한정어, 시점). 같은 키에 값이 둘 이상이면 &lt;b&gt;충돌&lt;/b&gt; 이고 둘 다 보관한다. dated 한 칸이 시계열과 충돌을 가른다.&#xa;&lt;b&gt;node&lt;/b&gt;  &lt;b&gt;병합 키가 없다.&lt;/b&gt; fact_key 로만 묶고 근거 청크를 쌓는다 — 다른 말을 하는 청크가 나란히 매달린다.&#xa;&lt;b&gt;uncategorized&lt;/b&gt;  이유를 함께 적는다. 온톨로지 밖 topic · 모르는 항목 이름 · 값이 비어 있음 · 서술 노드가 없는 topic 넷." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="435" width="760" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="f4" value="③ 저장 — wiki_fact.place_kind 는 셋뿐이다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="580" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f4a" value="models.py:680 — String(16) 에 'slot' · 'node' · 'uncategorized' 만 들어간다.&#xa;&lt;b&gt;여기에 orbit 이 없다.&lt;/b&gt; 사실은 슬롯 이름이나 노드 이름으로만 앉는다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="565" width="760" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="f5" value="④ orbit — 15자리 · 읽을 때 만든다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8e8fb;strokeColor=#5b5bd6;fontStyle=1;fontColor=#332f7a;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="580" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="f5a" value="&lt;b&gt;저장에 없는 층이다.&lt;/b&gt; build.read_orbit() 이 슬롯 14 와 노드 10 을 &lt;b&gt;화면 자리 15개&lt;/b&gt; 로 다시 묶는다.&#xa;되돌리는 표도 같은 함수 안에 있다 — home[(place_kind, place)] → 궤도 키(build.py:391).&#xa;&lt;b&gt;빈 자리도 돌려준다.&lt;/b&gt; 비어 있는 것도 사실이고 물어야 할 자리다 — 지우면 무엇이 없는지 모른다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="675" width="760" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f0" target="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1" target="f2">
