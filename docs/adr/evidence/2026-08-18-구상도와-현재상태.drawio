        <mxCell id="be8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0f766e;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b2" source="b2_2" target="b2_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b45309;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b2" source="b2_3" target="b2_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="③ 자격 · 추천 — 도면 7번 · plan/03 (진행중)" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1560" y="1190" width="720" height="200" as="geometry" />
        </mxCell>
        <mxCell id="b3_1" value="① Structured Filter&#xa;&#xa;notice-filter/&#xa;기업마당 1,524 → 580&#xa;배제형 룰 12축 · LLM 0회&#xa;첨부 44건 눈으로 확인&#xa;T-0052 (2026-08-18)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b3">
          <mxGeometry x="20" y="50" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b3_2" value="제품 편입&#xa;&#xa;없다&#xa;&#xa;src/finnect/ 와 web/ 에&#xa;아무것도 안 붙어 있다&#xa;T-0053 재현율 · T-0054 K-Startup&#xa;T-0055 편입" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b3">
          <mxGeometry x="250" y="50" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b3_3" value="②③ 의미 검색 · LLM 재평가&#xa;&#xa;없다&#xa;&#xa;선행이 둘 다 아직이다 —&#xa;사업 위키(F1)와 공고 Embedding&#xa;점수·막대는 안 만든다 (DESIGN §6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b3">
          <mxGeometry x="480" y="50" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="be10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#cbd0d6;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b3" source="b3_1" target="b3_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#cbd0d6;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="b3" source="b3_2" target="b3_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="④ 사업계획서 자동 작성 · 화면 — 도면 8번 · SPEC S1~S7" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1420" width="2240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="b4_1" value="도면 8번 ①~⑦ 전부 없다&#xa;&#xa;선행이 둘 다 아직이다 — 위키 노드(F1)와 공고 요구사항(F2-3)&#xa;계획 파일도 아직 안 썼다 (틀린 문서를 미리 쓰지 않는다)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="50" y="50" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b4_2" value="재료 하나는 이미 있다&#xa;&#xa;공고 상세에 '내야 할 서류'와 작성 항목 트리가 뜬다&#xa;도면 8-② 요구사항 로딩의 입력 · plan/11 T-0035 · T-0037 · T-0038" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="590" y="50" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b4_3" value="화면 S4 · S5 는 돈다&#xa;&#xa;제품 목록 · 공고 상세 — Next.js · Vercel 프로덕션&#xa;운영 조회 화면 넷도 같이 올라가 있다 (ADR-0027)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="1130" y="50" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b4_4" value="화면 S1 · S2 · S3 · S6 · S7 은 없다&#xa;&#xa;다섯 장이 통째로 없다. 화면 대부분이 '아직 없어요'로 비어 있고&#xa;그게 의도다 — 예시 데이터를 넣지 않는다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="b4">
          <mxGeometry x="1670" y="50" width="520" height="100" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="지금 하나가 둘을 함께 막는다 — LLM 제공자가 안 정해졌다.&#xa;plan/11 T-0036(양식 구간 판별)과 plan/12 T-0045(사실 추출)가 같은 블로커를 공유하고, 먼저 착수하는 쪽이 정한다 (ADR-0021 G). 이 하나가 풀리기 전까지 도면 1번 ④⑤⑦, 3·4·5번 박스, 7번 ②③, 8번 전체가 열리지 않는다." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f4;strokeColor=#d92d20;fontColor=#d92d20;fontSize=12;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1620" width="2240" height="90" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
