        <mxCell id="er1u" value="아니다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="r1" target="u1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er12" value="맞다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="r1" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er2s" value="맞다 — 정형" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="r2" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="er2n" value="아니다 — 서술" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="r2" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es1u" value="못 찾는다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="s1" target="u2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es12" value="찾는다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es2u" value="비었다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="s2" target="u3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es23" value="있다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en1u" value="못 찾는다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="n1" target="u4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="en12" value="찾는다" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="530" />
              <mxPoint x="1030" y="800" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="tb1h" value="SLOT_ALIASES — 43줄 → 슬롯 14개" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="110" width="480" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="tb1" value="&lt;b&gt;왼쪽은 문서가 쓴 말, 오른쪽은 우리 이름이다.&lt;/b&gt; 정확 일치 dict 조회다 — 부분 문자열이 아니라서 오탐이 없다.&#xa;&#xa;상시 근로자 · 종업원 수 · 구성원 · 임직원 · 직원 수&#xa;    →  &lt;b&gt;headcount&lt;/b&gt;&#xa;소재지 · 사업장소재지 · 본사 · 본점소재지 · 주소&#xa;    →  &lt;b&gt;location&lt;/b&gt;&#xa;개업연월일 · 개업일 · 설립일 · 설립연월일&#xa;    →  &lt;b&gt;founded_on&lt;/b&gt;&#xa;&#xa;&lt;b&gt;표현이 넷 다 달라도 한 슬롯으로 모인다.&lt;/b&gt; 문자열이 다르다고 슬롯이 갈리면 직원 수 넷이 네 자리에 앉아 성장이 사라진다.&#xa;&#xa;코퍼스 7건에 &lt;b&gt;실제로 나온 표현만&lt;/b&gt; 담았다 — 없는 표현을 미리 넣지 않는다. 새 이름은 uncategorized 로 서고 그때 한 줄을 더한다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="140" width="480" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="tb2h" value="TOPIC_NODE — 23줄 → 노드 10개" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="460" width="480" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="tb2" value="customer_problem · customer_evidence  →  &lt;b&gt;problem&lt;/b&gt;&#xa;vision  →  &lt;b&gt;identity&lt;/b&gt;   ← 한 줄뿐이다&#xa;service_overview · service_feature · service_differentiator ·&#xa;development_status · technology · patent · certification&#xa;    →  &lt;b&gt;solution&lt;/b&gt;   ← 일곱이 여기로 모인다&#xa;target_customer  →  &lt;b&gt;customer&lt;/b&gt;&#xa;market_size · market_trend · competitor  →  &lt;b&gt;market&lt;/b&gt;&#xa;region_link  →  &lt;b&gt;region&lt;/b&gt;&#xa;revenue · revenue_model · pricing · go_to_market  →  &lt;b&gt;traction&lt;/b&gt;&#xa;cost · funding  →  &lt;b&gt;finance&lt;/b&gt;&#xa;team  →  &lt;b&gt;team&lt;/b&gt;      roadmap  →  &lt;b&gt;roadmap&lt;/b&gt;&#xa;&#xa;&lt;b&gt;라벨이 세밀할수록 좋고 노드는 집필 단위와 맞아야 한다.&lt;/b&gt; 그래서 25 를 10 으로 모은다 — 한쪽을 줄이면 다른 쪽이 무너진다.&#xa;&#xa;&lt;b&gt;TOPICS 25 − TOPIC_NODE 23 = 둘.&lt;/b&gt; company_profile · application_history 는 일부러 빠져 있다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="490" width="480" height="360" as="geometry"/>
        </mxCell>

        <mxCell id="p2n" value="&lt;b&gt;네 갈래 다 버리지 않는다.&lt;/b&gt; uncategorized 는 이유를 함께 들고 화면에 &quot;검토 대기&quot; 로 뜬다 — 다시로 6건 · 나린데이터 12건." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="880" width="900" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="p2n2" value="&lt;b&gt;슬롯 판정이 노드 판정보다 먼저다.&lt;/b&gt; 한 문장이 값과 서술을 둘 다 담으면 추출기가 사실을 둘로 낸다 — 여기서 가르는 것이 아니다." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="905" width="900" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
