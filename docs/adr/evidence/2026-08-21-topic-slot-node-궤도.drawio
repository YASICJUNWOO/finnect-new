        <mxCell id="e3a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3a" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3b" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f3c" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e45" value="읽을 때" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="sum" value="세 층 한 줄 요약 — 그리고 층이 아닌 둘" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sum0" value="&lt;b&gt;층 1 · sector 6&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 SECTORS(topics.py:359)&lt;/b&gt;   ·   등록 정보 · 대표와 이력 · 문제와 해결 · 시장과 고객 · 성과와 자금 · 팀과 계획   ·   &lt;b&gt;묶음이다. 사실이 여기 안 앉는다&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum1" value="&lt;b&gt;층 2 · orbit 15&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 ORBIT(topics.py:370)&lt;/b&gt;   ·   MD 한 장 = 그래프 점 하나   ·   event 쪽은 place 에 그대로 있고 value 쪽은 read_orbit() 이 모은다   ·   코드 topics.ORBIT + Orbit.tsx" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#5b5bd6;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="850" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum2" value="&lt;b&gt;층 3 · topic 37&lt;/b&gt;   잎이다   ·   &lt;b&gt;타입 둘로 갈린다&lt;/b&gt; — value 14 + event 23   ·   화면에 이름이 붙는 자리가 15 에서 37 로 늘었다(ADR-0048 결과)" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum3" value="&lt;b&gt;타입 A · value topic 14&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 VALUE_ALIASES(43줄)&lt;/b&gt;   ·   병합 키 (이름, 한정어, 시점)   ·   place_kind='value'   ·   코드 topics.VALUE_SPECS   ·   &lt;b&gt;충돌이 생기는 유일한 타입&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="930" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum4" value="&lt;b&gt;타입 B · event topic 23&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 TOPIC_ORBIT(23줄)&lt;/b&gt;   ·   &lt;b&gt;병합 키가 없다&lt;/b&gt; (fact_key 로만 묶는다)   ·   place_kind='event'   ·   코드 topics.TOPIC_ORBIT + TOPIC_LABELS   ·   &lt;b&gt;근거를 쌓기만 한다&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="970" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sumn" value="&lt;b&gt;층이 아닌 숫자 둘이 이 그림에 같이 있다.&lt;/b&gt; TOPICS 25 는 LLM 라벨 어휘이고, EVENT_ORBITS 10(topics.py:170) 은 event topic 을 받는 orbit 만 센 것이라 orbit 15 의 부분집합이다. &lt;b&gt;둘 다 세는 단위가 달라서 37 · 15 와 안 맞는다&lt;/b&gt; — 어긋나는 자리는 「위키 추출 경로」 도면 4쪽에 있다." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="1014" width="1400" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. 라우팅 — 표 둘이 목적지를 정한다">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2t" value="라우팅 — 사실 하나가 어디로 가나" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2s" value="src/finnect/wiki/merge.py place()(merge.py:72) — 판정 순서가 이 순서다. 오른쪽 표 둘이 topics.py 에 있는 사람이 만든 dict 다. LLM 은 이 표를 못 바꾼다. &lt;b&gt;kind 값이 'value'·'event' 다&lt;/b&gt; — ADR-0049 가 스키마까지 옮겼다." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1500" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="r0" value="사실 하나&#xa;(topic, kind, key, value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="topic 이 TOPICS 안에 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="210" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="uncategorized&#xa;&quot;온톨로지 밖 topic&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="220" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r2" value="kind 가 'value' 인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="340" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="value_of(key) 가 찾나?&#xa;VALUE_ALIASES 조회" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="260" height="100" as="geometry"/>
        </mxCell>
