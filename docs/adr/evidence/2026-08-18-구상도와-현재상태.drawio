        <mxCell id="b2" value="② 공고 — 도면 6번 · plan/06 · 07 · 11 · 13" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1190" width="1480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="b2_1" value="목록 수집&#xa;&#xa;31,327건&#xa;기업마당 1,538&#xa;K-Startup 29,789&#xa;plan/06 완료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="30" y="50" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_2" value="첨부 내려받기&#xa;&#xa;3,354건 · 약 2GB&#xa;콘텐츠 주소 저장&#xa;ADR-0022 · plan/07 완료" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="270" y="50" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_3" value="텍스트 해독&#xa;&#xa;2,827 / 3,354&#xa;지원 4포맷 모수 94.6%&#xa;HWP·HWPX·DOCX 100%&#xa;PDF 86.1%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="510" y="50" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_4" value="작성 항목 추출&#xa;&#xa;칸 채우기형 공고 953/1,474&#xa;서술형은 규칙이 네 번 실패&#xa;unknown 5,874 — T-0036 보류&#xa;도면 6-A 의 일부" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="750" y="50" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_5" value="K-Startup 첨부&#xa;&#xa;공고 29,789건(95%)에&#xa;첨부가 아직 없다&#xa;T-0048 코드만 · 아직 안 돌렸다&#xa;plan/13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="990" y="50" width="220" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2_6" value="공고 Embedding&#xa;&#xa;없다&#xa;&#xa;도면 6-C&#xa;벡터가 정말 필요한 쪽이 여기다" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="b2">
          <mxGeometry x="1230" y="50" width="220" height="120" as="geometry" />
