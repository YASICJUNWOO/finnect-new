  <!-- ============================================================ -->
  <!-- P1. 서비스 흐름 (F1~F9)                                       -->
  <!-- ============================================================ -->
  <diagram id="p1-flow" name="1. 서비스 흐름 F1~F9">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p1t" value="finnect-new · 서비스 흐름 (F1~F9)" style="text;html=1;fontFamily=Pretendard;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="28" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="p1s" value="출처 function.md §2·§3 — &lt;b&gt;판별이 먼저고 화면은 그 결과를 받는다&lt;/b&gt;" style="text;html=1;fontFamily=Pretendard;fontSize=14;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="900" height="24" as="geometry"/></mxCell>

        <mxCell id="p1lt" value="판별 트랙" style="text;html=1;fontFamily=Pretendard;fontSize=13;fontStyle=1;fontColor=#0969da;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="118" width="200" height="24" as="geometry"/></mxCell>
        <mxCell id="p1rt" value="집필 트랙" style="text;html=1;fontFamily=Pretendard;fontSize=13;fontStyle=1;fontColor=#0969da;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="680" y="118" width="200" height="24" as="geometry"/></mxCell>

        <mxCell id="F1" value="&lt;b&gt;F1&amp;nbsp; 내 정보&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S8 (시연 제외)&lt;/span&gt;&lt;br&gt;&lt;br&gt;판별용 — 사업자 형태 · 등록일 · 대표 생년월일 · 소재지 · 업종 · 수령 이력&lt;br&gt;집필용 — 문제인식 · 솔루션 · 목표고객 · 매출성과 · 성장전략 · 팀구성 (PSST)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="380" height="100" as="geometry"/></mxCell>

        <mxCell id="F2" value="&lt;b&gt;F2&amp;nbsp; 자격 판별&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;b style=&quot;color:#0969da&quot;&gt;화면 없음&lt;/b&gt;&lt;br&gt;&lt;br&gt;F2-1&amp;nbsp; 요건 대조 판정 — 업력 · 연령 · 소재지 · 업종 · 결격 사유 · 중복 제한&lt;br&gt;F2-2&amp;nbsp; 파생값 계산 — 공고별 기준일로 업력 · 만나이 재계산&lt;br&gt;F2-3&amp;nbsp; &lt;b&gt;결정론 보장&lt;/b&gt; — LLM 미사용. 같은 입력에 항상 같은 판정&lt;br&gt;F2-4&amp;nbsp; 프로필 변경 시 색인 전체 재판정" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="380" height="118" as="geometry"/></mxCell>

        <mxCell id="F3" value="&lt;b&gt;F3&amp;nbsp; 지원사업 리스트&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S1&lt;/span&gt;&lt;br&gt;&lt;br&gt;판정 결과가 곧 목록이다. 신청 가능 공고만 노출&lt;br&gt;마감 임박 순 정렬 (D-7 이내 강조) · 출처 필터 (전체 / 중앙부처 / 지자체)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="100" y="448" width="380" height="100" as="geometry"/></mxCell>

        <mxCell id="F4" value="&lt;b&gt;F4&amp;nbsp; 공고 상세&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S2&lt;/span&gt;&lt;br&gt;&lt;br&gt;개요 · 지원 내용 · 신청 자격 · 제출 서류 · 심사 방식과 배점 · 유의사항&lt;br&gt;원문을 인용하지 않고 링크로만 연결&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;신청 자격 블록에 내 값과 판정을 넣지 않는다&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="100" y="588" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="F5" value="&lt;b&gt;F5&amp;nbsp; 공고 분석&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S3&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#9a6700&quot;&gt;★ 승부처&lt;/b&gt;&lt;br&gt;&lt;br&gt;결론 3줄을 먼저 말한다. 근거는 접어 둔다&lt;br&gt;심사 항목과 배점 (높은 순) · 목차 구조 · 강조 지점&lt;br&gt;&lt;b&gt;아직 모르는 것&lt;/b&gt; → 그대로 다음 단계의 질문이 된다" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="680" y="150" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="F6" value="&lt;b&gt;F6&amp;nbsp; 내용 채우기&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S4&lt;/span&gt;&lt;br&gt;&lt;br&gt;부족 정보만 질문한다 · 질문마다 &lt;b&gt;&quot;○○ 30점&quot; 배점 표기&lt;/b&gt;&lt;br&gt;기보유 정보 자동 채움 · 강조축 선택 · 금지 표현 지정 · 건너뛰기&lt;br&gt;답변은 내 정보에 누적 저장 → 다음 공고에서 다시 묻지 않는다" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="680" y="308" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="F7" value="&lt;b&gt;F7&amp;nbsp; 초안 작성&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S5&lt;/span&gt;&amp;nbsp;&amp;nbsp;&lt;b style=&quot;color:#9a6700&quot;&gt;★ 승부처&lt;/b&gt;&lt;br&gt;&lt;br&gt;심사 항목 단위 생성 (배점 높은 순) · 첫 출력 5초 이내 스트리밍&lt;br&gt;&lt;b&gt;F7-3 사실 고정&lt;/b&gt; — 금액 · 자격 · 마감일은 공고 데이터만 쓴다&lt;br&gt;항목 재생성 · 사용자 수정 문단 보존 · 분량 카운터" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="680" y="458" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="F8" value="&lt;b&gt;F8&amp;nbsp; 문서 산출&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S6&lt;/span&gt;&lt;br&gt;&lt;br&gt;미리보기 · 누락 항목 체크 · PDF 내보내기 · 책임 고지" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="680" y="616" width="380" height="86" as="geometry"/></mxCell>

        <mxCell id="F9" value="&lt;b&gt;F9&amp;nbsp; 신청 현황&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;S7&lt;/span&gt;&lt;br&gt;&lt;br&gt;상태별 목록 — 검토 중 → 준비 중 → 작성 중 → 제출 준비 완료 → 제출함&lt;br&gt;마감 임박 경고 (D-7) · &lt;b&gt;다음 할 일 + 버튼&lt;/b&gt; · 계획서 진행률&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;상태는 사용자가 직접 바꾼다. 제출 여부를 시스템이 판단하지 않는다&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="390" y="790" width="380" height="110" as="geometry"/></mxCell>

        <mxCell id="p1n1" value="&lt;b&gt;한 줄 정의&lt;/b&gt; &lt;span style=&quot;color:#59636e&quot;&gt;function.md §1&lt;/span&gt;&lt;br&gt;&lt;br&gt;내 사업 정보로 &lt;b&gt;신청 가능한 공고를 판정&lt;/b&gt;하고,&lt;br&gt;그 판정 결과를 &lt;b&gt;심사 배점에 맞춘 사업계획서 초안&lt;/b&gt;으로 잇는다.&lt;br&gt;&lt;br&gt;핵심은 판정과 집필을 잇는 &lt;b&gt;연결&lt;/b&gt;이다.&lt;br&gt;둘 중 하나만 있으면 이미 있는 서비스다." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1160" y="150" width="380" height="180" as="geometry"/></mxCell>

        <mxCell id="p1n2" value="&lt;b&gt;이번에 뺀 것&lt;/b&gt; &lt;span style=&quot;color:#59636e&quot;&gt;function.md §5&lt;/span&gt;&lt;br&gt;&lt;br&gt;· 판별 과정 노출 (대조표 · 미충족 사유 · 조건 칩)&lt;br&gt;· 운영 기능 (수집 스케줄러 · 검수 큐 · 지표 대시보드)&lt;br&gt;· 계정과 과금 (회원가입 · 결제)&lt;br&gt;· 알림 발송 (이메일 · 알림톡) — 화면 배지까지만&lt;br&gt;· HWPX 지정 양식 · 도식/표 자동 생성&lt;br&gt;· 계획서 재활용 · 캘린더 뷰 · 가점 판정" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#59636e;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1160" y="360" width="380" height="200" as="geometry"/></mxCell>

        <mxCell id="p1n3" value="&lt;b style=&quot;color:#9a6700&quot;&gt;★ 승부처 두 곳&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;S3 공고 분석&lt;/b&gt;은 배점(L1)과 자격 판정(L2)이 &lt;b&gt;둘 다 있어야&lt;/b&gt; 나오는 출력이다.&lt;br&gt;배점만 아는 도구도, 자격만 아는 도구도 이 화면을 만들 수 없다.&lt;br&gt;&lt;br&gt;&lt;b&gt;S5 초안 작성&lt;/b&gt;은 그 배점 순서 그대로 집필로 이어간다." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1160" y="590" width="380" height="170" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F1" target="F2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F2" target="F3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="행 클릭" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="F3" target="F4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="계획서 쓰기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0969da;fontColor=#0969da;fontFamily=Pretendard;fontSize=11;fontStyle=1;endArrow=blockThin;endFill=1;strokeWidth=2;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F4" target="F5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F5" target="F6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F6" target="F7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="F7" target="F8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F8" target="F9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="준비 시작" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F3" target="F9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="498"/><mxPoint x="50" y="845"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="다음 할 일 · 이어서 쓰기" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#59636e;fontColor=#59636e;fontFamily=Pretendard;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="F9" target="F7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="845"/><mxPoint x="1110" y="568"/></Array></mxGeometry></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ============================================================ -->
  <!-- P2. 정보구조 (IA)                                             -->
  <!-- ============================================================ -->
  <diagram id="p2-ia" name="2. 정보구조 IA">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p2t" value="정보구조 · 화면 전이 (S1~S8)" style="text;html=1;fontFamily=Pretendard;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="28" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="p2s" value="출처 service_spec.md §2 — LNB 3축 · 실선은 주 동선, 점선은 &lt;b&gt;다음 할 일&lt;/b&gt; 복귀 동선" style="text;html=1;fontFamily=Pretendard;fontSize=14;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="66" width="900" height="24" as="geometry"/></mxCell>

        <mxCell id="gnb" value="&lt;b&gt;상단 GNB&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; ◆ 라스트마일 &amp;nbsp;·································································································&amp;nbsp; 🔔 &amp;nbsp;&amp;nbsp; ( 정 ) ▾" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="1400" height="54" as="geometry"/></mxCell>

        <mxCell id="S8" value="&lt;b&gt;S8&amp;nbsp; 내 정보&lt;/b&gt;&amp;nbsp; · &amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;F1 · 시연 제외&lt;/span&gt;&lt;br&gt;&lt;br&gt;├&amp;nbsp; 개인정보 탭&lt;br&gt;└&amp;nbsp; 사업 정보 탭&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ├ 판별에 쓰는 정보 → 고치면 전체 재판정&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; └ 계획서 작성에 쓰는 정보 (S4 답변 누적)" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1160" y="210" width="340" height="130" as="geometry"/></mxCell>

        <mxCell id="lnb" value="&lt;b&gt;좌측 LNB&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#59636e;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="220" height="290" as="geometry"/></mxCell>
