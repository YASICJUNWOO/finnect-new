        <mxCell id="p5t" value="문서 맵 — 피봇과 공백" style="text;html=1;fontFamily=Pretendard;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="28" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="p5s" value="docs/ 안의 문서 4개는 &lt;b&gt;서로 다른 두 제품&lt;/b&gt;을 말하고 있다. 08-13 → 08-15 사이에 피봇이 있었다." style="text;html=1;fontFamily=Pretendard;fontSize=14;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="66" width="1000" height="24" as="geometry"/></mxCell>

        <mxCell id="oldbox" value="&lt;b&gt;① 구 방향&lt;/b&gt;&amp;nbsp;&amp;nbsp;청년 개인 정책 추천" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#59636e;fontFamily=Pretendard;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="80" y="130" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="d1" value="&lt;b&gt;idea-v1.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;85줄&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;초개인화 정책 AI 에이전트. 타깃 청년 19~34세.&lt;br&gt;킬러 = 중복 수혜 판정 + 지식그래프. BM 정책 자격 확인 API.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="106" y="180" width="508" height="96" as="geometry"/></mxCell>
        <mxCell id="d2" value="&lt;b&gt;재사용자산_인벤토리.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;100줄 · 2026-08-13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;구 finnect(차차) 백엔드 실사. idea-v1 기준으로 &quot;어디까지 있고 어디부터 0인가&quot;.&lt;br&gt;→ 4페이지 참고&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="106" y="292" width="508" height="96" as="geometry"/></mxCell>

        <mxCell id="pivot" value="&lt;b&gt;피봇&lt;/b&gt;" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontColor=#0969da;fontFamily=Pretendard;fontSize=14;fontStyle=1;arrowWidth=0.5;arrowSize=0.4;" vertex="1" parent="1"><mxGeometry x="670" y="250" width="180" height="70" as="geometry"/></mxCell>

        <mxCell id="newbox" value="&lt;b&gt;② 현행&lt;/b&gt;&amp;nbsp;&amp;nbsp;창업 지원사업 판정 + 사업계획서 집필" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontColor=#0969da;fontFamily=Pretendard;fontSize=13;fontStyle=1;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;" vertex="1" parent="1"><mxGeometry x="880" y="130" width="560" height="300" as="geometry"/></mxCell>
        <mxCell id="d3" value="&lt;b&gt;function.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;184줄 · 2026-08-15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;핵심 기능 F1~F9. 타깃 초기창업자. 킬러 = 판정 × 배점 연결.&lt;br&gt;§6에 미답변 확인 요청 5건.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="906" y="180" width="508" height="96" as="geometry"/></mxCell>
        <mxCell id="d4" value="&lt;b&gt;service_spec.md v4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;781줄 · 2026-08-15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;화면 설계서. IA · 와이어프레임 · 디자인 토큰 · 카피 규칙 · 목업 데이터 전부 확정.&lt;br&gt;&lt;b&gt;승인되면 HTML 데모로 넘어간다.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="906" y="292" width="508" height="96" as="geometry"/></mxCell>

        <mxCell id="warn" value="&lt;b&gt;타깃&lt;/b&gt; 청년 개인 → 초기창업 사업자&amp;nbsp;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;킬러 기능&lt;/b&gt; 중복수혜 판정 → 배점 기반 계획서&amp;nbsp;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;b&gt;코퍼스&lt;/b&gt; 온통청년·복지로 → 기업마당·K-Startup&lt;br&gt;→ 인벤토리의 &quot;재사용 가능&quot; 판정은 &lt;b&gt;구 방향 기준&lt;/b&gt;이라 현행에 상당 부분 적용되지 않는다. &lt;b&gt;창업 지원사업 기준으로 자산 실사 재작성 필요.&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="80" y="456" width="1360" height="80" as="geometry"/></mxCell>

        <mxCell id="missing" value="&lt;b style=&quot;color:#d1242f&quot;&gt;정본으로 인용되지만 docs/ 에 없는 문서 4개&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;service_spec.md 첫 줄 — &quot;정본 순서는 context.md → PRD.md → function.md&quot;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;context.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;정본 1순위. §6이 제출 서류·유의사항 블록의 근거&lt;br&gt;&lt;b&gt;PRD.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;정본 2순위. &lt;b&gt;D1~D18 결정의 출처&lt;/b&gt; (§1.1 전체가 여기 의존)&lt;br&gt;&lt;b&gt;research.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;경쟁 조사(1장) · 심사 3단계(2.3) · 디자인 방침(4.4~4.6) · 체크리스트(5.3)&lt;br&gt;&lt;b&gt;dev_research.md&lt;/b&gt;&amp;nbsp;&amp;nbsp;첨부 파싱 가능성 — &lt;b&gt;1순위 확인 대상&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="80" y="566" width="660" height="230" as="geometry"/></mxCell>

        <mxCell id="open" value="&lt;b style=&quot;color:#9a6700&quot;&gt;열린 질문&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;function.md §6 확인 요청 5건&lt;/span&gt;&lt;br&gt;&lt;br&gt;1.&amp;nbsp; F7-3 사실 고정을 화면에 표시할까&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#1a7f37&quot;&gt;→ §11.1에서 &quot;표시 안 함, 기능은 유지&quot;로 답함&lt;/span&gt;&lt;br&gt;2.&amp;nbsp; 중복 수령 제한을 F2-1 요건의 한 종류로 넣은 것 확인&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#9a6700&quot;&gt;미답&lt;/span&gt;&lt;br&gt;3.&amp;nbsp; LNB를 지원사업 / 신청 현황 / 사업계획서로 갈까&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#9a6700&quot;&gt;미답 (D17로 가정 반영됨)&lt;/span&gt;&lt;br&gt;4.&amp;nbsp; PSST를 실제 심사 항목명으로 쓸까&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#9a6700&quot;&gt;미답 (spec은 쓰는 것으로 그림)&lt;/span&gt;&lt;br&gt;5.&amp;nbsp; research.md 1장 경쟁 조사를 context.md · PRD.md에 반영할까&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#9a6700&quot;&gt;미답&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="780" y="566" width="660" height="230" as="geometry"/></mxCell>

        <mxCell id="p5e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0969da;endArrow=none;endFill=0;strokeWidth=2;" edge="1" parent="1" source="oldbox" target="pivot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p5e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0969da;endArrow=none;endFill=0;strokeWidth=2;" edge="1" parent="1" source="pivot" target="newbox"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

