        <mxCell id="b1" value="&lt;b&gt;추출 스키마 어휘 교체&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;현재 고정 필드가 자립준비청년 특화 — &lt;span style=&quot;font-family:monospace&quot;&gt;care_ended · care_end_years · care_duration_years&lt;/span&gt; 3개를 빼야 한다.&lt;br&gt;&lt;b&gt;구조는 그대로, 어휘만 교체&lt;/b&gt;하면 되는 형태로 설계돼 있어 비용이 작다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="580" y="188" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="b2" value="&lt;b&gt;교정 루프&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;sanitize.py&lt;/span&gt; · &lt;span style=&quot;font-family:monospace&quot;&gt;mapper.py&lt;/span&gt; 는 있음.&lt;br&gt;idea-v1 §5-1의 &quot;원문 재읽기 재추출 루프&quot;는 확인 필요.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="580" y="330" width="460" height="100" as="geometry"/></mxCell>
        <mxCell id="b3" value="&lt;b&gt;추천 이유 생성&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;matching 결과 → LLM 설명 경로가 이미 있음. 배점 기반 서술로 재배선.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="580" y="442" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="b4" value="&lt;b&gt;대상 코퍼스 자체&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;color:#d1242f&quot;&gt;(피봇 영향)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;인벤토리는 &lt;b&gt;청년 개인 정책&lt;/b&gt; 기준. 현행 방향은 &lt;b&gt;창업 지원사업 공고&lt;/b&gt;다.&lt;br&gt;온통청년·복지로 코퍼스가 그대로 쓰이지 않는다 → &lt;b&gt;자산 실사 재작성 필요&lt;/b&gt;.&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;.env 의 수집 키는 bizinfo · data.go.kr(K-Startup) · 온통청년 3종.&lt;/span&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="580" y="544" width="460" height="130" as="geometry"/></mxCell>

        <mxCell id="c1x" value="&lt;b&gt;지식그래프 엣지&lt;/b&gt;&amp;nbsp;&amp;nbsp;정책 ↔ 정책&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;충돌 · 호환 · 전환 관계. &lt;b&gt;코드베이스에 개념 자체가 없다.&lt;/b&gt;&lt;br&gt;idea-v1 의 유일무이한 차별점이자 100% 신규 개발 영역.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1080" y="188" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="c2x" value="&lt;b&gt;하이브리드 검색&lt;/b&gt;&amp;nbsp;&amp;nbsp;BM25 + 임베딩&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;현재는 결정론 키워드 부분매칭(ILIKE + 페르소나 재정렬).&lt;br&gt;CLAUDE.md 에는 pgvector+BM25가 &lt;b&gt;계획&lt;/b&gt;으로만 적혀 있고 미구현.&lt;br&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;DomainRetriever&lt;/span&gt; 인터페이스는 있어 교체 지점은 깨끗하다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1080" y="310" width="460" height="126" as="geometry"/></mxCell>
        <mxCell id="c3x" value="&lt;b&gt;첨부 문서 파싱 (HWP/HWPX)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;service_spec §11.2 — 배점표가 공고 본문이 아니라 &lt;b&gt;첨부 안&lt;/b&gt;에 있는 것으로 보인다.&lt;br&gt;&lt;b style=&quot;color:#d1242f&quot;&gt;배점을 못 얻으면 S3 공고 분석이 성립하지 않는다.&lt;/b&gt; dev_research.md 1순위 확인 대상.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1080" y="448" width="460" height="126" as="geometry"/></mxCell>
        <mxCell id="c4x" value="&lt;b&gt;배점 기반 집필 파이프라인 (L3)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;F5~F8 전체. 인벤토리 조사 시점(08-13)에 없던 방향이라 실사 대상에 아예 포함되지 않았다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1080" y="586" width="460" height="88" as="geometry"/></mxCell>

        <mxCell id="rt" value="리스크 · 문서와 코드가 어긋나는 지점" style="text;html=1;fontFamily=Pretendard;fontSize=15;fontStyle=1;fontColor=#d1242f;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="830" width="600" height="26" as="geometry"/></mxCell>

        <mxCell id="rk1" value="&lt;b&gt;🔴 미검증 전제 — 이 숫자 하나가 아이디어의 생사를 가른다&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;&quot;중복 제한 조항이 몇 %의 공고문에 명시돼 있는가&quot;를 아무도 안 세어봤다. 명시율이 낮으면 지식그래프 엣지가 텅 비고, 남는 건 기존 서비스보다 조금 나은 필터링뿐이다.&lt;br&gt;&lt;b&gt;→ 가장 먼저 할 일: 2,634건 grep 실측 (반나절)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffebe9;strokeColor=#d1242f;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="80" y="866" width="460" height="146" as="geometry"/></mxCell>
        <mxCell id="rk2" value="&lt;b&gt;⚠️ 이름 함정 — &quot;중복배제 C1~C4&quot;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;&lt;span style=&quot;font-family:monospace&quot;&gt;agents/matching/spec.py&lt;/span&gt; 의 &lt;span style=&quot;font-family:monospace&quot;&gt;exclusionary&lt;/span&gt; 는 &lt;b&gt;대상특성 게이트&lt;/b&gt;(장애인 전용 정책을 비장애인에게 안 보여주는 것)다.&lt;br&gt;정책↔정책 동시수혜 판정이 &lt;b&gt;아니다.&lt;/b&gt; 이름만 같고 딴 것.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="580" y="866" width="460" height="146" as="geometry"/></mxCell>
        <mxCell id="rk3" value="&lt;b&gt;⚠️ 발표 숫자 검증 필요&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;idea-v1 은 &quot;온통청년 3,981건&quot;이라 썼는데 스냅샷은 &lt;b&gt;2,634건&lt;/b&gt;이다. 7월 수집 조건 차이일 수도, 인용 오류일 수도 있다.&lt;br&gt;&lt;b&gt;→ 발표 숫자로 쓰기 전 재수집해 실측&lt;/b&gt;&lt;br&gt;service_spec §11.2의 배점 30/30/25/15도 미확인 값이다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1080" y="866" width="460" height="146" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

