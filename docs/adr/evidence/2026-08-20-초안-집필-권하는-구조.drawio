          <mxGeometry x="710" y="60" width="180" height="240" as="geometry" />
        </mxCell>

        <mxCell id="sa1" value="항목 1 — 서브에이전트 루프    AGENT → TOOL → EXECUTE → COMPACT → AGENT    (도구 K회 상한)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#b45309;fontColor=#7c3f06;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="c1">
