        <mxCell id="lg1" value="돌아간다 — 실측으로 확인됨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="240" height="36" as="geometry" />
