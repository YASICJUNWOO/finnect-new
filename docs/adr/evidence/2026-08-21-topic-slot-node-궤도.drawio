        <mxCell id="ob1" value="문제 인식&#xa;problem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
