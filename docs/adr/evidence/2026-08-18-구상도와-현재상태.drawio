        <mxCell id="a2" value="2. 저장소 구성" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1540" y="110" width="740" height="290" as="geometry" />
        </mxCell>
        <mxCell id="a2_1" value="A. Original File Storage — 원본 보관 (PDF/DOCX/XLSX/PPTX/이미지/TXT) → Source of Truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a2">
          <mxGeometry x="20" y="50" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2_2" value="B. Node Store (조회용) — 정형 엔티티 데이터 (SQL DB) → 정확한 조회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a2">
          <mxGeometry x="20" y="95" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2_3" value="C. Vector DB (RAG용) — Wiki Chunk + Embedding + Metadata (company_id 파티션)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a2">
          <mxGeometry x="20" y="140" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2_4" value="D. Metadata DB — 출처/페이지/섹션/버전/구조 · 온톨로지 매핑 · 신뢰도 관리" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a2">
          <mxGeometry x="20" y="185" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a2_5" value="E. Review Queue — uncategorized Fact 및 충돌 검토 항목" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="a2">
          <mxGeometry x="20" y="230" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="3 · 4 · 5. Fact Extraction · 고정 topic 온톨로지 · 충돌 정보 관리" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="720" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a3_1" value="3. Fact Extraction&#xa;&#xa;원문을 바로 Wiki 로 재작성하지&#xa;않고 사실 단위로 추출한다&#xa;&#xa;원본 → Fact + Metadata → Wiki&#xa;&#xa;company_id · topic · series&#xa;fact · source(document, page)&#xa;confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a3">
          <mxGeometry x="20" y="50" width="210" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a3_2" value="4. 고정 topic 온톨로지 (v3 핵심)&#xa;&#xa;엔티티 계열 (병합·조회 대상)&#xa;company_profile · vision · team&#xa;service_* · market_* · customer_*&#xa;pricing · revenue · funding …&#xa;&#xa;이벤트 계열 (append·검색 대상)&#xa;meeting · decision · action_item&#xa;application_history&#xa;&#xa;topic 은 온톨로지에서 선택&#xa;자유 생성 금지" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a3">
          <mxGeometry x="250" y="50" width="210" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a3_3" value="5. 충돌 정보 관리 (엔티티)&#xa;&#xa;이전 값 (2026.01)&#xa;직원 수 10명 · 상태 이전&#xa;↓&#xa;현재 값 (2026.08)&#xa;직원 수 15명 · 상태 최신&#xa;&#xa;최신성 기준 우선&#xa;새 파일 추가 시 전체 Wiki&#xa;재생성 없이 변경분만 반영" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a3">
          <mxGeometry x="480" y="50" width="210" height="180" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="6. 공고 DB (공고 관리)" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="430" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a4_1" value="A. Structured Data (정형)&#xa;기본정보 · 지원자격 · 제출서류&#xa;사업계획서 항목 · 평가기준 · 작성조건" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a4">
          <mxGeometry x="20" y="50" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4_2" value="B. Original Document (원본 보관)&#xa;PDF / HTML / 원문 텍스트&#xa;→ Source of Truth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a4">
          <mxGeometry x="20" y="115" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a4_3" value="C. Embedding (의미 검색용)&#xa;공고 원문 Chunk Embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a4">
          <mxGeometry x="20" y="180" width="380" height="55" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="7. 공고 추천 (3단계)" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1240" y="430" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a5_1" value="① Structured Filter (조건 필터링)&#xa;지원자격 · 신청기 · 지역 · 업종/분야 · 사업자 여부&#xa;→ 지원 가능한 공고 생성" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a5">
          <mxGeometry x="20" y="50" width="480" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a5_2" value="② Semantic Search (의미 기반 검색)&#xa;사용자 사업 Embedding ↔ 공고 Embedding&#xa;→ Top-K 공고 선정" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a5">
          <mxGeometry x="20" y="115" width="480" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a5_3" value="③ LLM 재평가 (적합도 평가)&#xa;적합도 점수 · 추천 이유 · 주의 사항 · 핵심 조건&#xa;상세보기에 Retrieval → 근거 설명" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;verticalAlign=top;spacingTop=6;" vertex="1" parent="a5">
          <mxGeometry x="20" y="180" width="480" height="55" as="geometry" />
        </mxCell>

        <mxCell id="a6" value="8. 사업계획서 자동 작성" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="1790" y="430" width="490" height="250" as="geometry" />
        </mxCell>
        <mxCell id="a6_1" value="① 공고 선택&#xa;② 공고 요구사항 로딩 — 작성 항목 · 글자 수 · 필수 내용 · 평가 기준&#xa;③ 사용자 Wiki RAG (필요 시) — 엔티티 조회 / 이벤트 RAG&#xa;④ 공고 원문 Retrieval (필요 시) — 원문 근거 확인&#xa;⑤ LLM 생성 — 공고 요구사항 + Wiki RAG 결과 + 원문 근거&#xa;⑥ 검증 / 검사 — 필수 항목 · 글자 수 · 허위 감사 · 공고 표현 수 제한&#xa;⑦ 완성 사업계획서 — PDF / DOCX / 한글 / 마크다운" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="a6">
          <mxGeometry x="20" y="50" width="450" height="130" as="geometry" />
        </mxCell>
        <mxCell id="a6_2" value="각 항목별 출처(근거) 표시 + 수정 · 보완 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f5f6;strokeColor=#cbd0d6;fontColor=#5f656d;fontSize=10;" vertex="1" parent="a6">
          <mxGeometry x="20" y="190" width="450" height="40" as="geometry" />
        </mxCell>

        <mxCell id="a9" value="9. 기술 스택 (예시) — Backend Python/FastAPI · DB PostgreSQL · Vector DB Pinecone/Weaviate · LLM OpenAI/Claude/Gemini · Embedding OpenAI/Cohere · Storage AWS S3/GCS · Infra AWS/GCP/Azure&#xa;10. 공통 관리 기능 — 파일/공고 관리 · 버전/이력 관리 · 출처 추적 · 알림/마감 관리 · 권한/보안 · 백업/복구 · 감사 로그" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=11;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="710" width="2240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="bhdr" value="섹션 B · 지금 구현된 것 / 안 된 것 — 2026-08-18 갱신 (plan/12 닫힘 · 14 · 15 진행중 · API 가 자체 서버로 내려옴) · 진행 상태 정본은 docs/plan/README.md" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16181b;strokeColor=none;fontColor=#ffffff;fontSize=16;fontStyle=1;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="2240" height="44" as="geometry" />
