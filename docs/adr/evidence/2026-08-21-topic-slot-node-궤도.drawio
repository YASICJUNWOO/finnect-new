        <mxCell id="sum" value="네 층 한 줄 요약" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="400" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sum1" value="&lt;b&gt;topic 25&lt;/b&gt;   누가 정하나 &lt;b&gt;LLM&lt;/b&gt;   ·   병합 키 없음   ·   DB 에 wiki_fact.topic 으로 남는다   ·   코드 topics.TOPICS   ·   &lt;b&gt;라벨이다. 자리가 아니다&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum2" value="&lt;b&gt;slot 14&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 SLOT_ALIASES(43줄)&lt;/b&gt;   ·   병합 키 (이름, 한정어, 시점)   ·   place_kind='slot'   ·   코드 topics.SLOTS   ·   &lt;b&gt;충돌이 생기는 유일한 층&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum3" value="&lt;b&gt;node 10&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 TOPIC_NODE(23줄)&lt;/b&gt;   ·   병합 키 없다 (fact_key 로만 묶는다)   ·   place_kind='node'   ·   코드 topics.NODES   ·   &lt;b&gt;근거를 쌓기만 한다&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="900" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sum4" value="&lt;b&gt;orbit 15&lt;/b&gt;   누가 정하나 &lt;b&gt;사람 표 ORBIT&lt;/b&gt;   ·   병합 키 없음   ·   &lt;b&gt;DB 에 없다 — 읽기 뷰다&lt;/b&gt;   ·   코드 topics.ORBIT + Orbit.tsx   ·   &lt;b&gt;화면의 단위이고 병합의 단위가 아니다&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fillColor=#ffffff;strokeColor=#5b5bd6;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="940" width="1380" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="sumn" value="&lt;b&gt;네 숫자가 하나도 안 맞는다.&lt;/b&gt; 25 → 23 → 10 이고 43 → 14 이고, 그 24개가 15자리에 앉는다. 어디서 어긋나는지는 4쪽에 있다." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="984" width="1380" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. 라우팅 — 표 둘이 목적지를 정한다">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2t" value="라우팅 — 사실 하나가 어디로 가나" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="p2s" value="src/finnect/wiki/merge.py place() — 판정 순서가 이 순서다. 오른쪽 표 둘이 topics.py 에 있는 사람이 만든 dict 다. LLM 은 이 표를 못 바꾼다." style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1300" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="r0" value="사실 하나&#xa;(topic, kind, key, value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="topic 이 TOPICS 안에 있나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="210" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="u1" value="uncategorized&#xa;&quot;온톨로지 밖 topic&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="220" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="r2" value="kind 가 'slot' 인가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="340" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="slot_of(key) 가 찾나?&#xa;SLOT_ALIASES 조회" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="uncategorized&#xa;&quot;모르는 항목 이름 — {key!r}&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="500" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="value 가 비었나?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="u3" value="uncategorized&#xa;&quot;값이 비어 있음 — {key!r}&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="635" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="Placement('slot', slot)&#xa;슬롯 14 중 하나" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="760" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="node_of(topic) 가 찾나?&#xa;TOPIC_NODE 조회" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="480" width="260" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="u4" value="uncategorized&#xa;&quot;서술 노드가 없는 topic&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="640" width="260" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u4n" value="&lt;b&gt;company_profile&lt;/b&gt; 과 &lt;b&gt;application_history&lt;/b&gt; 둘이 여기다. 정형 슬롯의 재료라 서술 노드를 안 만들었다 — 서술 문장으로 오면 갈 곳이 없다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="710" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Placement('node', node)&#xa;노드 10 중 하나" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="800" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="er01" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r0" target="r1">
          <mxGeometry relative="1" as="geometry" />
