        <mxCell id="r2" value="&lt;b&gt;요건 · 금액 · 마감일 · 배점 · 서류&lt;/b&gt;를 생성하지 않는다&amp;nbsp;&amp;nbsp;/&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;지원 내용 개요만 LLM 정제 허용&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#e4e8ed;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="560" height="56" as="geometry"/></mxCell>
