        <mxCell id="ob5" value="지역 연계&#xa;region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="930" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ob6" value="매출과 성과&#xa;traction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="840" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ob7" value="자금 현황&#xa;finance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="650" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ob8" value="팀 구성&#xa;team" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="340" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ob9" value="로드맵&#xa;roadmap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2ef;strokeColor=#0f766e;fontColor=#0b5a54;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="130" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sec1" value="문제와 해결" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#0b5a54;" vertex="1" parent="1">
          <mxGeometry x="650" y="170" width="140" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sec2" value="시장과 고객" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#0b5a54;" vertex="1" parent="1">
          <mxGeometry x="800" y="805" width="140" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sec3" value="성과와 자금" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#0b5a54;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="140" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="sec4" value="팀과 계획" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#0b5a54;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="140" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="secn" value="&lt;b&gt;구획 라벨이 바깥 궤도에만 있다.&lt;/b&gt; 안쪽 다섯(등록 정보 · 대표와 이력)은 지름이 작아 라벨을 얹으면 노드 이름과 겹친다 — 대신 구획 사이를 각도로 벌렸다. 안쪽 구획 이름은 누르면 패널이 적는다. ADR-0017 결정 2 에서 이 하나를 덜 했다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#d4d4d4;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="960" width="880" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="t3a" value="자리 15개 — 무엇을 담나" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1060" y="110" width="560" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="t3b" value="&lt;b&gt;중심 하나 — kind 'identity'&lt;/b&gt;&#xa;identity  우리가 하는 일   슬롯 company_name   노드 identity&#xa;&lt;b&gt;슬롯과 노드를 둘 다 가진 유일한 중심이다.&lt;/b&gt; sector 값('registration')은 안 쓰인다 — 중심은 링에 안 앉는다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#5b5bd6;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="140" width="560" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="t3c" value="&lt;b&gt;안쪽 다섯 — kind 'company' · M1 자격 판별의 입력&lt;/b&gt;&#xa;biz     사업자 정보   등록 정보     슬롯 business_no · corp_no · founded_on&#xa;where   소재지        등록 정보     슬롯 location&#xa;what    업종          등록 정보     슬롯 industry · industry_item&#xa;who     대표자        대표와 이력   슬롯 ceo_name · ceo_birth&#xa;grants  수령 이력     대표와 이력   슬롯 gov_program&#xa;&#xa;&lt;b&gt;다섯 다 서술 노드가 없다. 값만 앉는다.&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#9a3412;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="245" width="560" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="t3d" value="&lt;b&gt;바깥 아홉 — kind 'content' · M2 적합도와 G 집필의 입력&lt;/b&gt;&#xa;problem   문제 인식      문제와 해결   노드 problem&#xa;solution  솔루션과 기술  문제와 해결   노드 solution&#xa;customer  목표 고객      시장과 고객   노드 customer&#xa;market    시장과 경쟁    시장과 고객   노드 market&#xa;region    지역 연계      시장과 고객   노드 region&#xa;traction  매출과 성과    성과와 자금   노드 traction  + 슬롯 revenue&#xa;finance   자금 현황      성과와 자금   노드 finance   + 슬롯 capital · funding&#xa;team      팀 구성        팀과 계획     노드 team      + 슬롯 headcount&#xa;roadmap   로드맵         팀과 계획     노드 roadmap&#xa;&#xa;&lt;b&gt;아홉 다 노드가 있고 그중 셋이 슬롯도 갖는다.&lt;/b&gt; 직원 수 · 자본금 · 매출액 · 조달액 넷은 SPEC F1-2 의 &apos;사업체 정보 다섯&apos; 에 없어서 안쪽이 아니라 바깥으로 온다 — 팀 구성 · 매출과 성과 · 자금 현황을 읽을 때 같이 봐야 하는 값이다." style="text;html=1;align=left;verticalAlign=top;fillColor=#ffffff;strokeColor=#0f766e;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="440" width="560" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="t3e" value="&lt;b&gt;색은 kind 만 말한다&lt;/b&gt; — identity #5b5bd6 · company #9a3412 · content #0f766e (DESIGN.md §2).&#xa;신뢰도나 상태를 색조로 말하지 않는다. 빈 자리는 속을 비우고 점선을 두르되 &lt;b&gt;테두리 색은 제 종류 색&lt;/b&gt; 이고, 손봐야 하는 자리는 오른쪽 위에 배지 점을 하나 더 붙인다.&#xa;&#xa;&lt;b&gt;힘 기반 배치를 쓰지 않는다&lt;/b&gt;(ADR-0017). 자리가 고정돼야 두 번째 볼 때 찾는다 — 물리 배치는 열 때마다 모양이 달라진다.&#xa;&#xa;&lt;b&gt;노드 사이 선이 없다.&lt;/b&gt; 연결이 아직 데이터에 없어서다. 같은 구획에 있다고 이어 버리면 사용자가 근거 있는 연결로 읽는다." style="text;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1060" y="745" width="560" height="200" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
