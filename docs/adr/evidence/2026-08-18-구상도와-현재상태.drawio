        <mxCell id="b1" value="① 사업 위키 — 도면 1번 · plan/12 완료 (2026-08-18) · 화면은 plan/14 · 15" style="swimlane;startSize=34;html=1;fillColor=#f7f7f8;strokeColor=#dfe2e6;fontColor=#16181b;fontSize=13;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
