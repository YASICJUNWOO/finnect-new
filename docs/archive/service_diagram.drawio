        <mxCell id="r4" value="&lt;span style=&quot;color:#59636e&quot;&gt;없음&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#e4e8ed;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="960" y="480" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="r5" value="&lt;b&gt;금액 · 자격 · 마감일&lt;/b&gt;을 생성하지 않는다&amp;nbsp;&amp;nbsp;/&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;F7-3 사실 고정&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="960" y="560" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="r6" value="&lt;span style=&quot;color:#59636e&quot;&gt;없음&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#e4e8ed;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="960" y="640" width="560" height="56" as="geometry"/></mxCell>
        <mxCell id="r7" value="마감일을 생성하지 않는다" style="rounded=1;absoluteArcSize=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#e4e8ed;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="960" y="720" width="560" height="56" as="geometry"/></mxCell>

        <mxCell id="p3note" value="&lt;b&gt;§11.1 확정&lt;/b&gt;&amp;nbsp;&amp;nbsp;F7-3 사실 고정을 &lt;b&gt;화면에는 표시하지 않는다&lt;/b&gt;. 생성문의 금액·자격이 공고 데이터에서 왔음을 알리는 장치를 두지 않는다 — 판별 근거 노출을 걷어낸 것과 같은 성격이고, 초안을 읽는 흐름을 방해하며, 내보낼 때 제거할 요소만 늘어난다.&amp;nbsp;&amp;nbsp;&lt;b&gt;다만 기능은 유지한다.&lt;/b&gt; 모델이 금액과 자격을 지어내지 못하게 하는 백엔드 규칙은 환각 방지의 핵심이다." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="100" y="820" width="1420" height="90" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

