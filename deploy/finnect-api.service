# finnect API — systemd **user** 서비스 (ADR-0035).
#
#     cp deploy/finnect-api.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now finnect-api
#
# **root 가 필요 없다.** 이 서버는 sudo 에 비밀번호가 걸려 있고 `linger` 가 이미 켜져
# 있어서(`loginctl show-user $USER -p Linger` → yes) 로그아웃해도, 재부팅해도 올라온다.

[Unit]
Description=finnect API (FastAPI · uvicorn)
# DB 는 Docker 라 systemd 가 순서를 모른다. 그래서 기다리지 않고 **죽으면 다시 뜬다**
# (Restart=always). API 가 DB 보다 먼저 떠도 몇 초 뒤 스스로 회복한다.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/joonoo3/project/finnect-new

# 토큰은 **레포 밖에 있다.** `.env` 에 두면 개발 서버(`--port 8100`)도 같이 읽어서
# `npm run dev` 가 401 을 받는다. 환경변수가 `.env` 보다 우선이라 여기만 켜진다.
# `-` 는 파일이 없어도 기동한다는 뜻이고, 그때는 토큰 없이 열린 채로 뜬다.
EnvironmentFile=-%h/.config/finnect/api.env

# **워커를 늘리지 않는다.** `ingest/jobs.py` 의 락이 `threading.Lock` 이라 프로세스
# 안에서만 산다. `--workers 2` 로 띄우면 같은 회사의 위키 구축이 **두 번 동시에** 돌고,
# 청크가 두 벌 생긴다. 늘리려면 락을 DB 로 옮기는 것이 먼저다.
#
# **8101 이다. 8100 이 아니다** — 8100 은 개발용으로 비워 둔다. 배포 서비스가 떠 있어도
# `uv run uvicorn finnect.api.app:app --port 8100` 이 그대로 되어야 한다.
# 바깥은 Caddy 가 받는다 — uvicorn 을 직접 인터넷에 두지 않는다.
ExecStart=/home/joonoo3/project/finnect-new/.venv/bin/uvicorn finnect.api.app:app \
    --host 127.0.0.1 --port 8101 --workers 1

Restart=always
RestartSec=3

# OCR 한 쪽이 1.8GB 를 튀긴다(실측). 회사 셋이 겹치면 5.4GB 라 이 서버(7.9GB)가 스왑에
# 들어가고, 그때부터는 느린 것이 아니라 안 끝난다. **터지는 편이 낫다** — Restart 가 받는다.
MemoryMax=4G

# 파일을 다루는 서비스라 넉넉히 준다. 기본값(1024)은 첨부 3,354건에서 모자랐다.
LimitNOFILE=8192

[Install]
WantedBy=default.target
