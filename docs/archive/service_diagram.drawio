        <mxCell id="p6t" value="시연 동선 — 합 4분 40초" style="text;html=1;fontFamily=Pretendard;fontSize=24;fontStyle=1;fontColor=#1f2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="28" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="p6s" value="출처 service_spec.md §7 — 목업 데이터가 들어간 상태에서 시작한다. &lt;b&gt;내 정보(S8) 화면은 열지 않는다.&lt;/b&gt;" style="text;html=1;fontFamily=Pretendard;fontSize=14;fontColor=#59636e;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="66" width="1000" height="24" as="geometry"/></mxCell>

        <mxCell id="t1" value="&lt;b&gt;1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S1&lt;/b&gt; 지원사업 리스트&lt;br&gt;&lt;span style=&quot;color:#0969da&quot;&gt;30초&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;신청할 수 있는 공고 7건. 중앙부처와 지자체가 섞여 있다.&lt;br&gt;&lt;br&gt;뒤에서 판별이 이미 돌았다는 것을 &lt;b&gt;말로&lt;/b&gt; 설명한다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="t2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S2&lt;/b&gt; 공고 상세&lt;br&gt;&lt;span style=&quot;color:#0969da&quot;&gt;50초&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;공고 요강이 자격 · 서류 · 배점 · 유의사항으로 정리되어 있다.&lt;br&gt;&lt;br&gt;배점은 PSST 항목명.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="t3" value="&lt;b&gt;3&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S3&lt;/b&gt; 공고 분석&amp;nbsp;&lt;b style=&quot;color:#9a6700&quot;&gt;★&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9a6700&quot;&gt;&lt;b&gt;60초 · 핵심 장면&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;결론 3줄. 배점과 내 조건이 만나 강조 지점과 부족 정보가 나온다.&lt;br&gt;&lt;br&gt;&lt;b&gt;발표에서 시간을 가장 많이 쓴다.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="150" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="t4" value="&lt;b&gt;4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S4&lt;/b&gt; 내용 채우기&lt;br&gt;&lt;span style=&quot;color:#0969da&quot;&gt;40초&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;질문마다 배점이 붙어 있다.&lt;br&gt;&lt;br&gt;이 한 줄이 범용 도구와 갈리는 지점.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="t5" value="&lt;b&gt;5&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S5&lt;/b&gt; 초안 작성&amp;nbsp;&lt;b style=&quot;color:#9a6700&quot;&gt;★&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#9a6700&quot;&gt;&lt;b&gt;70초&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;배점 큰 항목부터 생성. 분량 카운터와 항목별 재작성.&lt;br&gt;&lt;br&gt;첫 출력 5초 이내 스트리밍.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="150" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="t6" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;S7&lt;/b&gt; 신청 현황&lt;br&gt;&lt;span style=&quot;color:#0969da&quot;&gt;30초&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;방금 쓴 계획서가 진행 상태로 들어와 있다.&lt;br&gt;&lt;br&gt;마감과 다음 할 일.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingTop=12;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1330" y="150" width="230" height="200" as="geometry"/></mxCell>

        <mxCell id="p6n1" value="&lt;b&gt;핵심 장면은 3번이다.&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;배점과 자격 판정이 둘 다 있어야 나오는 화면이라 범용 도구도 경쟁 서비스도 재현할 수 없다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontColor=#1f2328;fontFamily=Pretendard;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="80" y="410" width="480" height="130" as="geometry"/></mxCell>
        <mxCell id="p6n2" value="&lt;b&gt;1번에 관한 기록&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;판별을 화면에서 안 보여주므로 목록만 보면 추천 서비스와 구분이 안 된다. 이 부분은 발표에서 &lt;b&gt;판별 정확도를 수치로 따로 제시&lt;/b&gt;해 채운다. 화면으로 보완하지 않는다.&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="600" y="410" width="480" height="130" as="geometry"/></mxCell>
        <mxCell id="p6n3" value="&lt;b&gt;데모 프로필&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;color:#59636e&quot;&gt;§12.1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color:#59636e&quot;&gt;개인사업자 · 2025-04-02 등록(업력 1년 4개월) · 만 28세 · 경기 성남 · SW 개발업(58221) · 초기창업패키지 2025 수령&lt;/span&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#d1d9e0;fontColor=#1f2328;fontFamily=Pretendard;fontSize=13;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1120" y="410" width="440" height="130" as="geometry"/></mxCell>

        <mxCell id="p6e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="t4" target="t5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p6e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#59636e;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="t5" target="t6"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

