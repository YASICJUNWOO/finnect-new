# finnect API 앞의 리버스 프록시 (ADR-0035 · ADR-0036).
#
# **도메인 없이 HTTPS 다.** Let's Encrypt 가 2026-01-15 부터 IP 주소 인증서를 정식
# 발급한다. 조건이 둘이다 — `shortlived` 프로파일이어야 하고, 유효기간이 **160시간(약 6일)**
# 이다. 짧은 것이 문제가 아니다. Caddy 가 알아서 갱신하고, 오히려 폐기 정보를 안 실어도 된다.
#
# **Caddy 2.11.4 는 IP 인증서를 막지 않는다.** 이슈 #7399 가 "cannot have public IP
# certificate" 로 막힌다고 적었는데 이 버전에서는 통과한다 — 실제로 주문이 들어갔다.
#
# 도메인이 생기면 아래 IP 를 그 이름으로 바꾸고 `profile shortlived` 를 빼면 된다
# (도메인은 90일 인증서를 받는다).

{
	# **IP 로 접속하면 SNI 가 안 실린다** — RFC 6066 이 SNI 를 호스트명으로만 정해서
	# 클라이언트가 IP 리터럴에는 안 붙인다. 그러면 Caddy 가 어느 사이트인지 못 골라
	# 핸드셰이크를 내부 오류로 끊는다.
	#
	# **로컬 curl 만의 문제가 아니다.** Vercel 의 Node 도 IP 에는 SNI 를 안 실어서
	# 이 줄이 없으면 화면이 API 에 아예 못 붙는다.
	#
	# `tls` 안의 하위 지시어가 아니라 **전역 옵션이다.** 사이트 블록에 쓰면
	# `unknown subdirective: default_sni` 로 기동이 죽는다.
	default_sni 49.247.203.210
}

49.247.203.210 {
	tls {
		issuer acme {
			# **IP 인증서는 이 프로파일에서만 나온다.** 빼면 Let's Encrypt 가 거절한다.
			profile shortlived
		}
	}

	# **8101 이다.** 8100 은 개발용으로 비워 둔다 — 배포 서비스가 떠 있어도
	# 개발 백엔드를 따로 띄울 수 있어야 한다.
	# compose 가 `network_mode: host` 라 컨테이너가 호스트의 루프백을 그대로 본다.
	reverse_proxy 127.0.0.1:8101 {
		# 올리기가 50MB 까지 온다(`user_file_max_mb`). 기본 타임아웃으로는 느린 회선에서
		# 끊긴다. **OCR 대기가 아니다** — 그쪽은 202 로 먼저 답하고 뒤에서 돈다.
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}

	# 사업자등록증이 오가는 경로다. **누가 무엇을 올렸는지는 안 남긴다** — 접근 기록에
	# 파일명이 들어가면 그 로그 자체가 개인정보가 된다(ADR-0029).
	#
	# **토큰을 지운다.** 기본 형식이 요청 헤더를 통째로 찍어서 `X-Finnect-Token` 이
	# 평문으로 남는다. 로그를 보는 사람이 곧 API 를 부를 수 있는 사람이 된다.
	log {
		output stderr
		format filter {
			wrap console
			request>headers>X-Finnect-Token delete
			request>headers>Cookie delete
			request>headers>Authorization delete
		}
	}

	request_body {
		# `user_file_max_mb` 50 에 여유를 얹었다. 여러 개를 한 번에 올리므로
		# 파일 하나 상한과 요청 하나 상한은 다른 값이다 — 막는 것은 API 가 파일별로 한다.
		max_size 300MB
	}
}
