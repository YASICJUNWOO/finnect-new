# finnect-new 환경변수 템플릿 — 실제 값은 .env 에 (커밋 금지).
# 원칙: 시크릿·모델 ID·임계값은 코드에 하드코딩하지 않고 여기서 주입한다.
#
# 인증키는 공고 수집(ingest) 때만 쓴다. 조회 화면은 DB 만 읽는다.
# 프론트 번들에는 어느 것도 들어가지 않는다.

# ─── DB ───
# docker-compose.yml 의 포트와 맞춘다. 호스트 5432 를 점유하지 않으려고 55433 을 쓴다.
# 이 값은 config.py 의 기본값과 같다. 다르게 쓸 때만 .env 에 넣으면 된다.
DATABASE_URL=postgresql+psycopg://finnect:finnect@127.0.0.1:55433/finnect

# ─── 기업마당 (중소벤처기업부 bizinfo) ───
# 발급: https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi 하단 신청 폼 (로그인 불필요, 즉시 발급)
# ⚠️ 신청 시 입력한 IP 에서만 동작할 수 있다 / crtfcKey 는 쿼리스트링 전송 → 로그 마스킹 필수
# ⚠️ 인증 실패가 HTTP 200 + <reqErr> 로 온다 → item 수 말고 reqErr 를 먼저 검사할 것
BIZINFO_API_KEY=

# ─── 공공데이터포털 (data.go.kr) ───
# 마이페이지 > 활용신청 현황 > 일반 인증키(Encoding).
# API 마다 활용신청이 별도다(K-Startup: B552735/kisedKstartupService01).
DATA_GO_KR_API_KEY=

# ─── 온통청년 (한국고용정보원) — 지금 안 쓴다 ───
# **`config.py` 가 이 키를 안 읽는다.** 구 방향(청년 정책 추천)의 것이고 v2 피봇으로
# 대체됐다(ADR-0012 · docs/archive/). 발급받을 필요가 없다.
# 지우지 않고 남기는 이유는 `.env` 에 값이 들어 있는 사람이 있어서다 —
# 그 자리가 왜 죽었는지 여기 안 적으면 다시 채우려 든다.
# YOUTH_CENTER_API_KEY=

# ─── 배포 서버 (ADR-0035) ───
# API 를 부를 때 있어야 하는 토큰. 비어 있으면 검사하지 않는다(로컬 기본값).
# 만들기: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 같은 값을 Vercel finnect-web 의 FINNECT_API_TOKEN 에도 넣는다.
API_TOKEN=

# ─── LLM (ADR-0037) ───
# 발급: https://platform.openai.com/api-keys
# **이 한 줄만 채우면 된다.** 그다음 아래 WIKI_EXTRACTOR 를 llm 으로 바꾼다.
# 키가 없는데 llm 을 고르면 무엇이 없는지 말하고 멈춘다 — 조용히 스텁으로 안 물러난다.
OPENAI_API_KEY=

# 모델. ADR-0037 이 여기서부터 재기로 했다. 부족하면 gpt-5.6-terra · gpt-5.6-sol 로 올린다.
# 단가 $0.2 / $1.2 (1M 토큰) · 컨텍스트 105만 · 구조화 출력 지원.
OPENAI_MODEL=gpt-5.6-luna

# stub | llm.  stub 은 픽스처 7건에서만 돌고 키가 필요 없다(ADR-0031).
WIKI_EXTRACTOR=stub

# rule | llm.  양식 구간 판별 (plan/11 T-0036).
# **여기는 llm 이 기본이다** — 규칙은 이미 분할 때 한 번 돌았고 네 번 실패했다.
# rule 로 --classify 를 돌리면 아무것도 안 바뀌고, 그 결과가 "LLM 도 못 가른다" 처럼 보인다.
DOCUMENT_CLASSIFIER=llm

# 초안을 쓸 때 항목을 몇 개씩 동시에 부르나 (plan/16 T-0069).
# **상한은 rate limit 이다** — 크게 잡으면 429 재시도가 늘어 오히려 느려진다.
DRAFT_WORKERS=8

# 공고를 몇 개씩 동시에 정규화하나 (plan/17 T-0070). DRAFT_WORKERS 와 같은 이유로 8.
# **③④⑤ 에는 워커가 없다** — LLM 을 안 부르고 1,790건에 0.02초다.
MATCH_WORKERS=8

# ─── 사용자 파일 (ADR-0029 · ADR-0030) ───
# 사용자 파일에 OCR 을 쓸지. **첨부는 별도이고 꺼져 있다** — 켜면 plan/07 이 측정한
# 2,827/3,354 를 다시 재야 하고 총 비용을 아직 모른다.
# 사업자등록증이 거의 사진이라 이걸 끄면 자격 판별 입력 다섯 중 넷이 안 나온다.
# `uv sync --group ocr` 로 설치한다. 없으면 그림이 unsupported 로 남는다.
USER_FILE_OCR=true

# ─── 관측 (Langfuse) ───
# 발급: 프로젝트 Settings → API Keys.  **둘 다 넣어야 켜진다.**
# 없으면 추적이 그냥 꺼진다 — 정확성 기능이 아니라 보는 기능이라 없다고 멈추지 않는다.
# `langfuse` 패키지를 안 쓴다. OTLP/HTTP 엔드포인트 하나만 부른다(ADR-0037 결정 2 와 같은 이유).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU 기본값. 미국은 https://us.cloud.langfuse.com · 자체 호스팅이면 그 주소.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ─── 여기 일부러 안 적은 것 ───
# `config.py` 가 읽지만 이 파일에 없는 값이 열둘 있다. **누락이 아니라 기본값을 쓰라는
# 뜻이다** — 넣을 자리가 생기면 그때 여기에 이유와 함께 적는다.
#
#   REQUEST_DELAY_SEC 0.2 · REQUEST_TIMEOUT_SEC 60      상대 서버 부하 조절
#   ATTACHMENT_DIR · ATTACHMENT_FORMATS · ATTACHMENT_MAX_MB 100
#   USER_FILE_DIR · USER_FILE_FORMATS · USER_FILE_MAX_MB 50
#   CHUNK_TARGET_CHARS 900 · CHUNK_MAX_CHARS 1600       청킹 규칙
#   OPENAI_TIMEOUT_SEC 120 · WIKI_STUB_FACTS
#
# **ATTACHMENT_FORMATS 에 xlsx·pptx 를 더하지 마라.** plan/07 이 측정한 2,827/3,354 가
# 근거를 잃는다. 사용자 파일 쪽(USER_FILE_FORMATS)에는 이미 들어 있다.
#
# ─── 여기 두면 안 되는 것 ───
# **WIKI_EXTRACTOR=llm 을 배포 서버에서 켤 때는 `.env` 가 아니다.**
# `~/.config/finnect/api.env` 에 넣는다(deploy.md §A-1-1). 여기 두면 CLI 와 테스트가
# 전부 실제 LLM 호출을 하게 된다 — `--score` 한 번이 픽스처 118건을 부른다.
# API_TOKEN 도 같은 이유로 배포 서버에서는 그쪽에 산다.
