        <mxCell id="h1" value="1. 전체 구조 — 계획은 루프가 아니고, 루프는 항목 안에만 있다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16181b;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
