{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": null,
  "ignoreCommand": "git diff --quiet HEAD^ HEAD ./",
  "functions": {
    "api/index.py": {
      "includeFiles": "src/finnect/**",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
