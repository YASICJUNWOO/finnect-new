        </mxCell>
        <mxCell id="pb" value="①-b  배분&#xa;T-0064 · draft/allot.py&#xa;&#xa;겹침 쌍 안에서 후보가&#xa;겹칠 때만 부른다&#xa;&#xa;다투는 것이 없으면&#xa;호출 0회" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef7f4;strokeColor=#0f766e;fontColor=#0f4c46;fontSize=11;verticalAlign=top;spacingTop=8;spacingLeft=6;align=left;" vertex="1" parent="gp">
