        <mxCell id="gp" value="계획 — 고정 호출 2회 · 루프 아님" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#949aa2;dashed=1;fontColor=#5f656d;fontSize=11;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="c1">
